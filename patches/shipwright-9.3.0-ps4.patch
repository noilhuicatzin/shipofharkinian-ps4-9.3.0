+// ---------------------------------------------------------------------------
+// Registry access
+// ---------------------------------------------------------------------------
+const std::vector<Def>& GetDefs() {
+    return kDefs;
+}
+
+const Def* FindDef(int id) {
+    for (const Def& def : kDefs) {
+        if (def.id == id) {
+            return &def;
+        }
+    }
+    return nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// State (persisted via CVar)
+// ---------------------------------------------------------------------------
+bool IsUnlocked(int id) {
+    return CVarGetInteger(UnlockedCVar(id).c_str(), 0) != 0;
+}
+
+bool IsRevealed(int id) {
+    return CVarGetInteger(RevealedCVar(id).c_str(), 0) != 0;
+}
+
+void Reveal(int id) {
+    CVarSetInteger(RevealedCVar(id).c_str(), 1);
+    SaveNow();
+}
+
+bool HasUnseen() {
+    return CVarGetInteger(kHasUnseen, 0) != 0;
+}
+
+void MarkSeen() {
+    if (HasUnseen()) {
+        CVarSetInteger(kHasUnseen, 0);
+        SaveNow();
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Language
+// ---------------------------------------------------------------------------
+// NOTE (deviation to flag to Lux): the design says the toast follows the
+// game's menu language, but the game has NO Spanish (Language enum is only
+// ENG/GER/FRA/JPN, and only languages with a message table are offered).
+// So "follow the menu language" would make the ES strings dead. The Logros
+// menu therefore has its own EN/ES toggle (default English, following the
+// menu language per the spec); Lux can switch it to Español and both the
+// menu and the toasts follow it.
+int Language() {
+    return CVarGetInteger(kLanguage, 0);
+}
+
+bool IsSpanish() {
+    return Language() == 1;
+}
+
+std::string Title(const Def& def) {
+    return IsSpanish() ? def.titleEs : def.titleEn;
+}
+
+std::string Desc(const Def& def) {
+    return IsSpanish() ? def.descEs : def.descEn;
+}
+
+std::string Tr(const std::string& en, const std::string& es) {
+    return IsSpanish() ? es : en;
+}
+
+// ---------------------------------------------------------------------------
+// Totals
+// ---------------------------------------------------------------------------
+int TotalPoints() {
+    int total = 0;
+    for (const Def& def : kDefs) {
+        total += def.points;
+    }
+    return total;
+}
+
+int UnlockedCount() {
+    int count = 0;
+    for (const Def& def : kDefs) {
+        if (IsUnlocked(def.id)) {
+            count++;
+        }
+    }
+    return count;
+}
+
+int UnlockedPoints() {
+    int points = 0;
+    for (const Def& def : kDefs) {
+        if (IsUnlocked(def.id)) {
+            points += def.points;
+        }
+    }
+    return points;
+}
+
+int CategoryPoints(Category category) {
+    int points = 0;
+    for (const Def& def : kDefs) {
+        if (def.category == category) {
+            points += def.points;
+        }
+    }
+    return points;
+}
+
+int CategoryUnlockedPoints(Category category) {
+    int points = 0;
+    for (const Def& def : kDefs) {
+        if (def.category == category && IsUnlocked(def.id)) {
+            points += def.points;
+        }
+    }
+    return points;
+}
+
+int CategoryUnlockedCount(Category category) {
+    int count = 0;
+    for (const Def& def : kDefs) {
+        if (def.category == category && IsUnlocked(def.id)) {
+            count++;
+        }
+    }
+    return count;
+}
+
+int CategoryTotalCount(Category category) {
+    int count = 0;
+    for (const Def& def : kDefs) {
+        if (def.category == category) {
+            count++;
+        }
+    }
+    return count;
+}
+
+bool RewardEnabled(const char* rewardCvarSuffix) {
+    return CVarGetInteger(
+               (std::string("gAchievements.Reward.") + rewardCvarSuffix).c_str(), 1) != 0;
+}
+
+// ---------------------------------------------------------------------------
+// Navigation (toast action "Ver en Logros")
+// ---------------------------------------------------------------------------
+void OpenLogrosMenu() {
+    CVarSetString(CVAR_SETTING("Menu.ActiveHeader"), "Logros");
+    CVarSetString(CVAR_SETTING("Menu.LogrosSidebarSection"), "Logros");
+    auto gui = Ship::Context::GetRawInstance()->GetWindow()->GetGui();
+    auto menu = gui->GetMenu();
+    if (menu && !menu->IsVisible()) {
+        menu->Show();
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Detection (phase 1: the 13 progression achievements)
+// Every condition verified against the real 9.3.0 source (see
+// randomizer/RA-MAIN-SET.md). Quest bits: soh/include/z64item.h:85-105.
+// EventChkInf flags: soh/include/z64save.h:540-550.
+// ---------------------------------------------------------------------------
+static bool CheckProgression(int id) {
+    switch (id) {
+        case 2: // Entrusted Mission — Kokiri's Emerald
+            return CHECK_QUEST_ITEM(QUEST_KOKIRI_EMERALD);
+        case 4: // A Royal Autograph — met Princess Zelda (letter flag)
+            return Flags_GetEventChkInf(EVENTCHKINF_OBTAINED_ZELDAS_LETTER);
+        case 5: // Dance Into the Fire — Darunia's gift = Goron Bracelet
+                // (ITEM_BRACELET is the only source of strength level 1)
+            return CUR_UPG_VALUE(UPG_STRENGTH) >= 1;
+        case 7: // Soul Brothers — Goron's Ruby
+            return CHECK_QUEST_ITEM(QUEST_GORON_RUBY);
+        case 9: // Wedding Band — Zora's Sapphire
+            return CHECK_QUEST_ITEM(QUEST_ZORA_SAPPHIRE);
+        case 10: // Damsel in Distress — Ocarina of Time received
+            return Flags_GetEventChkInf(EVENTCHKINF_OBTAINED_OCARINA_OF_TIME);
+        case 11: // Hero of Time — Master Sword pulled from the pedestal
+            return Flags_GetEventChkInf(EVENTCHKINF_PULLED_MASTER_SWORD_FROM_PEDESTAL);
+        case 14: // Awakening — Forest Medallion
+            return CHECK_QUEST_ITEM(QUEST_MEDALLION_FOREST);
+        case 16: // Eternal Brothers — Fire Medallion
+            return CHECK_QUEST_ITEM(QUEST_MEDALLION_FIRE);
+        case 20: // Bride to Be — Water Medallion
+            return CHECK_QUEST_ITEM(QUEST_MEDALLION_WATER);
+        case 22: // The Shadow of the Hylians — Shadow Medallion
+            return CHECK_QUEST_ITEM(QUEST_MEDALLION_SHADOW);
+        case 27: // Brainwashed — Spirit Medallion
+            return CHECK_QUEST_ITEM(QUEST_MEDALLION_SPIRIT);
+        case 53: // The Way the World Learns to Dive — Silver Scale
+                 // (ITEM_SCALE_SILVER is the only source of scale level 1)
+            return CUR_UPG_VALUE(UPG_SCALE) >= 1;
+        default:
+            return false;
+    }
+}
+
+static bool IsProgression(int id) {
+    const Def* def = FindDef(id);
+    return def != nullptr && def->type == Type::Progression;
+}
+
+// ---------------------------------------------------------------------------
+// Unlock + toast
+// ---------------------------------------------------------------------------
+static void EmitUnlockToast(const std::vector<const Def*>& newlyUnlocked, bool firstEver) {
+    const std::string viewLabel = Tr("View in Achievements", "Ver en Logros");
+    auto openLogros = []() { OpenLogrosMenu(); };
+
+    if (firstEver) {
+        // Special notice on the first unlock ever.
+        int points = 0;
+        for (const Def* def : newlyUnlocked) {
+            points += def->points;
+        }
+        std::string message;
+        if (newlyUnlocked.size() == 1) {
+            message = Title(*newlyUnlocked.front());
+        } else if (IsSpanish()) {
+            message = spdlog::fmt_lib::format("{} logros nuevos", newlyUnlocked.size());
+        } else {
+            message = spdlog::fmt_lib::format("{} new achievements", newlyUnlocked.size());
+        }
+        Notification::Emit({
+            .itemIcon = newlyUnlocked.front()->icon,
+            .prefix = Tr("First achievement!", "¡Primer logro!"),
+            .message = message,
+            .suffix = spdlog::fmt_lib::format("+{} pts", points),
+            .actionLabel = viewLabel,
+            .action = openLogros,
+        });
+        return;
+    }
+
+    if (newlyUnlocked.size() == 1) {
+        const Def* def = newlyUnlocked.front();
+        Notification::Emit({
+            .itemIcon = def->icon,
+            .prefix = Tr("Achievement unlocked!", "¡Logro desbloqueado!"),
+            .message = Title(*def),
+            .suffix = spdlog::fmt_lib::format("+{} pts", def->points),
+            .actionLabel = viewLabel,
+            .action = openLogros,
+        });
+        return;
+    }
+
+    // Several unlocked in the same tick (e.g. loading an old save): one
+    // summary toast instead of a stack of them.
+    int points = 0;
+    for (const Def* def : newlyUnlocked) {
+        points += def->points;
+    }
+    const std::string summary =
+        IsSpanish() ? spdlog::fmt_lib::format("{} logros nuevos", newlyUnlocked.size())
+                    : spdlog::fmt_lib::format("{} new achievements", newlyUnlocked.size());
+    Notification::Emit({
+        .prefix = Tr("Achievements unlocked!", "¡Logros desbloqueados!"),
+        .message = summary,
+        .suffix = spdlog::fmt_lib::format("+{} pts", points),
+        .actionLabel = viewLabel,
+        .action = openLogros,
+    });
+}
+
+static void Tick() {
+    // Throttle: check every 30 frames (~0.5 s at 60 fps). Achievements are
+    // meta-progression; a half-second delay is unnoticeable.
+    static int frameCounter = 0;
+    if ((++frameCounter % 30) != 0) {
+        return;
+    }
+    // Only while a save is loaded (title screen / file select have no save).
+    if (!GameInteractor::IsSaveLoaded()) {
+        return;
+    }
+
+    const int unlockedBefore = UnlockedCount();
+    std::vector<const Def*> newlyUnlocked;
+    for (const Def& def : kDefs) {
+        if (!def.implemented || !IsProgression(def.id) || IsUnlocked(def.id)) {
+            continue;
+        }
+        if (CheckProgression(def.id)) {
+            CVarSetInteger(UnlockedCVar(def.id).c_str(), 1);
+            newlyUnlocked.push_back(&def);
+            SPDLOG_INFO("[Achievements] Unlocked {} ({} pts)", def.titleEn, def.points);
+        }
+    }
+    if (newlyUnlocked.empty()) {
+        return;
+    }
+    CVarSetInteger(kHasUnseen, 1);
+    SaveNow();
+    EmitUnlockToast(newlyUnlocked, unlockedBefore == 0);
+}
+
+// ---------------------------------------------------------------------------
+// Init
+// ---------------------------------------------------------------------------
+void Init() {
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnGameFrameUpdate>(Tick);
+}
+
+static RegisterShipInitFunc initFunc(Init);
+
+} // namespace Achievements
diff --git a/soh/soh/Enhancements/Achievements/Achievements.h b/soh/soh/Enhancements/Achievements/Achievements.h
new file mode 100644
index 00000000..7d853ad7
--- /dev/null
+++ b/soh/soh/Enhancements/Achievements/Achievements.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+// Local achievement system for Ship of Harkinian (PS4 port, 9.3.0).
+//
+// Design (closed 2026-11-12): 112 local achievements, 1000 points
+// (90 vanilla / 625 pts + 22 Randomizer / 375 pts). Local only: NOT PSN
+// trophies, NOT synced to RetroAchievements. Meta-progression: unlocks
+// persist across saves and seeds and give no gameplay advantage.
+// Each achievement carries title + description in EN and ES; the display
+// language is chosen in the Logros menu (gAchievements.Language).
+// The 14 story achievements (13 progression + 1 win condition) are hidden
+// ("???") until unlocked, and can be revealed by tapping them (spoiler
+// warning). Visual rewards (slot, titles, Triforce, logo, HUD, secret
+// message, jingle, fanfare) are a later phase; the toggle framework is
+// ready here.
+
+namespace Achievements {
+
+enum class Category { Vanilla, Randomizer };
+
+enum class Type { Progression, WinCondition, Missable, None };
+
+struct Def {
+    int id;               // Vanilla: RetroAchievements number (1-100, gaps = cut).
+                          // Randomizer: 1000 + number (1001-1022).
+    const char* titleEn;  // English title
+    const char* titleEs;  // Spanish title
+    const char* descEn;   // English description
+    const char* descEs;   // Spanish description
+    int points;
+    Category category;
+    Type type;
+    bool hidden;      // Story achievement: shown as "???" until unlocked.
+    const char* icon; // OTR texture path (e.g. "__OTR__textures/...") or nullptr.
+    bool implemented; // Detection wired (phase 1: only the 13 progression).
+};
+
+// Full registry (all 112 entries). Detection is wired only for the
+// implemented ones; the rest show as locked in the Logros menu.
+const std::vector<Def>& GetDefs();
+const Def* FindDef(int id);
+
+bool IsUnlocked(int id);
+bool IsRevealed(int id);
+void Reveal(int id); // Mark a hidden achievement as revealed (spoiler shown).
+bool HasUnseen();    // True when something new unlocked since the Logros menu
+                     // was last opened (drives the badge on the Logros tab).
+void MarkSeen();     // Clear the unseen flag (called when the Logros menu opens).
+
+// Display language: 0 = English, 1 = Español (CVar gAchievements.Language).
+int Language();
+bool IsSpanish();
+std::string Title(const Def& def);
+std::string Desc(const Def& def);
+// Translate a menu UI string to the display language.
+std::string Tr(const std::string& en, const std::string& es);
+
+int TotalPoints();    // 1000 (625 vanilla + 375 randomizer).
+int UnlockedCount();  // Unlocked achievements across both categories.
+int UnlockedPoints(); // Sum of points of unlocked achievements.
+int CategoryPoints(Category category);
+int CategoryUnlockedPoints(Category category);
+int CategoryUnlockedCount(Category category);
+int CategoryTotalCount(Category category);
+
+// Reward toggles (framework; the visuals land in a later phase).
+// Each reward has its own switch in the Logros menu; everything is off-able.
+bool RewardEnabled(const char* rewardCvarSuffix);
+
+// Navigate the SoH menu to the Logros section (used by the toast action).
+void OpenLogrosMenu();
+
+// Called once at boot (via RegisterShipInitFunc): registers the frame hook.
+void Init();
+
+} // namespace Achievements
