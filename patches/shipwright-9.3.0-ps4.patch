+// ---------------------------------------------------------------------------
+// Achievement rows as cards (run #30): 60x60 icon box (44x44 image,
+// grey tint when locked, dim empty box when the icon is nullptr),
+// "#N" + title, points pill + status badge on the right, Story /
+// Missable chips, description. Hidden rows keep the ??? reveal flow
+// (gRevealConfirm) inside the card.
+// ---------------------------------------------------------------------------
+static void DrawAchievementRow(const Achievements::Def& def) {
+    // One ImGui ID scope per row: without it, the 14 hidden "???" buttons
+    // (13 once one is unlocked or revealed) all share the label "???" and
+    // ImGui reports "13 visible items with conflicting ID" — and a click
+    // can land on the wrong row. This also scopes the Reveal/Cancel
+    // buttons, which share their labels across rows too.
+    ImGui::PushID(def.id);
+    const bool unlocked = Achievements::IsUnlocked(def.id);
+    const bool revealed = Achievements::IsRevealed(def.id);
+    const bool isHidden = def.hidden && !unlocked && !revealed;
+
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, kPalCard);
+    ImGui::PushStyleColor(ImGuiCol_Border, unlocked ? kPalGold : kPalLine);
+    ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, 14.0f);
+    ImGui::BeginChild("##achrow", ImVec2(0, 0), ImGuiChildFlags_Border | ImGuiChildFlags_AutoResizeY);
+
+    if (isHidden) {
+        // Story achievement: shown as "???" until unlocked. Tapping it
+        // asks for confirmation (spoiler warning) before revealing it.
+        if (ImGui::Button("???")) {
+            if (gRevealConfirm.count(def.id) != 0) {
+                gRevealConfirm.erase(def.id);
+            } else {
+                gRevealConfirm.insert(def.id);
+            }
+        }
+        ImGui::SameLine();
+        DrawPill("? PTS", kPillGrayBg, kPalMuted);
+        ImGui::SameLine();
+        DrawPill(Achievements::Tr("HIDDEN", "OCULTO").c_str(), kPillGraySoftBg, kPalMuted);
+        if (gRevealConfirm.count(def.id) != 0) {
+            ImGui::TextColored(kPalMuted, "%s",
+                               Achievements::Tr("This achievement is a story spoiler. Reveal it?",
+                                                "Este logro es un spoiler de la historia. ¿Revelarlo?")
+                                   .c_str());
+            if (ImGui::SmallButton(Achievements::Tr("Reveal", "Revelar").c_str())) {
+                Achievements::Reveal(def.id);
+                gRevealConfirm.erase(def.id);
+            }
+            ImGui::SameLine();
+            if (ImGui::SmallButton(Achievements::Tr("Cancel", "Cancelar").c_str())) {
+                gRevealConfirm.erase(def.id);
+            }
+        } else {
+            ImGui::TextColored(kPalMuted, "%s",
+                               Achievements::Tr("Tap to reveal (spoiler)", "Toca para revelar (spoiler)").c_str());
+        }
+        ImGui::EndChild();
+        ImGui::PopStyleVar();
+        ImGui::PopStyleColor(2);
+        ImGui::PopID();
+        return;
+    }
+
+    const std::string name = Achievements::Title(def);
+    const std::string desc = Achievements::Desc(def);
+    auto gui = GetGui();
+    const bool hasIcon = def.icon != nullptr && gui != nullptr && gui->HasTextureByName(def.icon);
+
+    if (ImGui::BeginTable("##rowtable", 3, ImGuiTableFlags_None)) {
+        ImGui::TableSetupColumn("icon", ImGuiTableColumnFlags_WidthFixed, 68.0f);
+        ImGui::TableSetupColumn("text", ImGuiTableColumnFlags_WidthStretch);
+        ImGui::TableSetupColumn("right", ImGuiTableColumnFlags_WidthFixed, 116.0f);
+        ImGui::TableNextRow();
+        ImGui::TableNextColumn();
+        // Icon box 60x60, image 44x44 inside; grey tint when locked.
+        {
+            ImDrawList* dl = ImGui::GetWindowDrawList();
+            const ImVec2 ip = ImGui::GetCursorScreenPos();
+            dl->AddRectFilled(ip, ImVec2(ip.x + 60, ip.y + 60),
+                              ImGui::GetColorU32(ImVec4(0.10f, 0.11f, 0.14f, 1.0f)), 10.0f);
+            if (hasIcon) {
+                ImGui::SetCursorScreenPos(ImVec2(ip.x + 8, ip.y + 8));
+                const ImVec4 tint = unlocked ? ImVec4(1, 1, 1, 1)
+                                             : ImVec4(0.43f, 0.47f, 0.54f, 1.0f); // #6e7789
+                // NOTE: imgui 1.91.9b has no 5-arg Image(); the tint
+                // overload takes 6 args (border_col = transparent).
+                ImGui::Image(gui->GetTextureByName(def.icon), ImVec2(44, 44), ImVec2(0, 0), ImVec2(1, 1), tint,
+                             ImVec4(0, 0, 0, 0));
+            } else {
+                // No icon (pixel-art achievements, nullptr by design):
+                // dim empty box.
+                ImGui::Dummy(ImVec2(60, 60));
+            }
+        }
+        ImGui::TableNextColumn();
+        ImGui::TextColored(kPalMuted, "#%d", def.id);
+        ImGui::SameLine();
+        ImGui::TextColored(unlocked ? kPalCream : kPalMuted, "%s", name.c_str());
+        ImGui::TextWrapped("%s", desc.c_str());
+        if (def.hidden) {
+            DrawPill(Achievements::Tr("Story", "Historia").c_str(), kChipStoryBg, kChipStoryFg);
+        }
+        if (def.type == Achievements::Type::Missable) {
+            if (def.hidden) {
+                ImGui::SameLine();
+            }
+            DrawPill(Achievements::Tr("Missable", "Perdible").c_str(), kChipMissBg, kChipMissFg);
+        }
+        ImGui::TableNextColumn();
+        // Points pill (gold when unlocked, grey when locked).
+        {
+            const std::string pts = spdlog::fmt_lib::format("{} PTS", def.points);
+            DrawPill(pts.c_str(), unlocked ? kPillGoldBg : kPillGrayBg,
+                     unlocked ? kPillGoldFg : kPalMuted);
+        }
+        // Status badge.
+        if (unlocked) {
+            DrawPill(Achievements::Tr("UNLOCKED", "DESBLOQUEADO").c_str(), kPillGreenBg, kPalGreen);
+        } else if (!def.implemented) {
+            DrawPill(Achievements::Tr("COMING SOON", "PRÓXIMAMENTE").c_str(), kPillGoldSoftBg, kPalGold);
+        } else {
+            DrawPill(Achievements::Tr("LOCKED", "BLOQUEADO").c_str(), kPillGraySoftBg, kPalMuted);
+        }
+        if (def.hidden && revealed && !unlocked) {
+            // Story achievement revealed (name visible) but still locked:
+            // offer a small "Hide" button to put it back to "???" (clears
+            // its Revealed CVar; takes effect on the next frame, no
+            // restart). Unlocked achievements never show it.
+            if (ImGui::SmallButton(Achievements::Tr("Hide", "Ocultar").c_str())) {
+                Achievements::Hide(def.id);
+            }
+        }
+        ImGui::EndTable();
+    }
+
+    ImGui::EndChild();
+    // Unlocked rows get the 5px gold bar on the left edge.
+    if (unlocked) {
+        const ImVec2 rmin = ImGui::GetItemRectMin();
+        const ImVec2 rmax = ImGui::GetItemRectMax();
+        ImGui::GetWindowDrawList()->AddRectFilled(ImVec2(rmin.x, rmin.y + 10), ImVec2(rmin.x + 5, rmax.y - 10),
+                                                  ImGui::GetColorU32(kPalGold), 2.5f);
+    }
+    ImGui::PopStyleVar();
+    ImGui::PopStyleColor(2);
+    ImGui::PopID();
+}
+
