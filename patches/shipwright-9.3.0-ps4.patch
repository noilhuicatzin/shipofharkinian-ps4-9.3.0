+    // Free slot colour (only at 1000 pts, Slot reward on). Stored as 3
+    // float CVars; default Radiant gold #e6c619.
+    if (Achievements::UnlockedPoints() >= 1000 && Achievements::RewardEnabled("Slot")) {
