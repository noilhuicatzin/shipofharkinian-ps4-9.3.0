+// Run #29, #1021 Flawless Boss Rush: a new Boss Rush file was created.
+// Called from BossRush_InitSave (BossRush.cpp). Resets the damage flag so
+// a fresh attempt starts clean; mid-rush save/load keeps the flag (it is
+// a CVar, and loading an existing file does not call InitSave).
+extern "C" void Achievements_NotifyBossRushStart() {
+    CVarSetInteger(kBossRushTookDamage, 0);
+    SaveNow();
+}
