+static bool CheckCondition(int id) {
+    if (IsProgression(id)) {
+        return CheckProgression(id);
+    }
+    const Def* def = FindDef(id);
+    if (def != nullptr && def->category == Category::Randomizer) {
+        return CheckRandomizer(id);
+    }
+    return CheckDirecto(id);
+}
