+// R1/L1 section switching (run #24, Lux): cycle the flat list of
+// (header, section) pairs in menu order, wrapping around. Activates the
+// target exactly like tapping its sidebar tab: the header CVar and the
+// target header's sidebar CVar are set and saved; DrawElement reads them
+// fresh on the next draw. Called from Achievements::CheckMenuInput with
+// the menu open (game input is blocked then, so R1/L1 cannot leak into
+// gameplay). No-op when there is one section or none, or when the current
+// position cannot be found.
+void Menu::CycleSidebarSection(int dir) {
+    if (dir == 0 || menuOrder.empty()) {
+        return;
+    }
+    const char* headerCvar = CVAR_SETTING("Menu.ActiveHeader");
+    const std::string headerIndex = CVarGetString(headerCvar, "Settings");
+    int total = 0;
+    int current = -1;
+    for (const std::string& header : menuOrder) {
+        auto it = menuEntries.find(header);
+        if (it == menuEntries.end()) {
+            continue;
+        }
+        const MainMenuEntry& entry = it->second;
+        if (header == headerIndex) {
+            const std::string sectionIndex = CVarGetString(entry.sidebarCvar, "");
+            int sectionPos = 0;
+            for (int i = 0; i < static_cast<int>(entry.sidebarOrder.size()); ++i) {
+                if (entry.sidebarOrder[i] == sectionIndex) {
+                    sectionPos = i;
+                    break;
+                }
+            }
+            current = total + sectionPos;
+        }
+        total += static_cast<int>(entry.sidebarOrder.size());
+    }
+    if (total <= 1 || current < 0) {
+        return;
+    }
+    int next = (current + dir) % total;
+    if (next < 0) {
+        next += total;
+    }
+    int remaining = next;
+    for (const std::string& header : menuOrder) {
+        auto it = menuEntries.find(header);
+        if (it == menuEntries.end()) {
+            continue;
+        }
+        const MainMenuEntry& entry = it->second;
+        const int count = static_cast<int>(entry.sidebarOrder.size());
+        if (remaining < count) {
+            CVarSetString(headerCvar, header.c_str());
+            CVarSetString(entry.sidebarCvar, entry.sidebarOrder[remaining].c_str());
+            CVarSave();
+            // TEMP DIAG: proves the section switch on console (dir: +1 = next
+            // section = visually down, -1 = previous = visually up).
+            SPDLOG_INFO("[PS4] [diag] menu section -> {} / {} (dir {})", header, entry.sidebarOrder[remaining],
+                        dir);
+            spdlog::default_logger()->flush();
+            return;
+        }
+        remaining -= count;
+    }
+}
