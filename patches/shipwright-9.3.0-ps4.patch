+// The win achievements checked before the save-loaded gate in Tick():
+// #31 (vanilla) and the six Randomizer wins (1002, 1008, 1010, 1011,
+// 1012, 1020). They share the END_CREDITS signal, which IsSaveLoaded()
+// never sees.
+static bool IsEndCreditsWin(int id) {
+    return id == 31 || id == 1002 || id == 1008 || id == 1010 || id == 1011 || id == 1012 ||
+           id == 1020;
+}
