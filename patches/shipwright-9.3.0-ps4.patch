+static bool CheckRandomizer(int id) {
+    // MODE EXEMPTIONS (run #29): these do NOT require a Randomizer seed.
+    // * 1001 (mod): the doc says "jugar con al menos un mod activo" —
+    //   no seed mentioned, and a mod works in vanilla too.
+    // * 1009 / 1021 (Boss Rush): IS_RANDO and IS_BOSS_RUSH are mutually
+    //   exclusive quest ids (z64save.h), so a Boss Rush save can never be
+    //   IS_RANDO. They are checked here (with the other Randomizer
+    //   achievements) because they are Randomizer-category, not because
+    //   they need a seed.
+    if (id == 1001) {
+        return HasActiveMod();
+    }
+    if (id == 1009) {
+        return IS_BOSS_RUSH &&
+               gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_BOSSRUSH_FINISH] != 0;
+    }
+    if (id == 1021) {
+        return IS_BOSS_RUSH &&
+               gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_BOSSRUSH_FINISH] != 0 &&
+               CVarGetInteger(kBossRushTookDamage, 0) == 0;
+    }
+    // Every other Randomizer achievement needs a seed loaded.
+    if (!IS_RANDO) {
+        return false;
+    }
+    switch (id) {
+        case 1003: // Would You Kindly — seed generated with Entrance Shuffle.
+            // FinalizeSettings resolves it to RO_GENERIC_ON when any
+            // entrance shuffle is on, else OFF (settings.cpp).
+            return RandoContextReady() && RandoSetting(RSK_SHUFFLE_ENTRANCES) != 0;
+        case 1004: // Token Shuffle — seed generated with Token Shuffle.
+            return RandoContextReady() && RandoSetting(RSK_SHUFFLE_TOKENS) != RO_TOKENSANITY_OFF;
+        case 1005: { // The price is a lie (run #29): a shop item was bought
+            // at a price above its vanilla price. Polls every shop
+            // location each throttled tick (cheap: ~20 locations) and
+            // compares the actual price with the vanilla price from the
+            // Randomizer data. With vanilla prices (RO_PRICE_VANILLA)
+            // the actual price equals the vanilla one, so it never
+            // fires — correctly.
+            if (!RandoContextReady() || OTRGlobals::Instance == nullptr ||
+                OTRGlobals::Instance->gRandomizer == nullptr) {
+                return false;
+            }
+            auto randoCtx = Rando::Context::GetInstance();
+            if (randoCtx == nullptr) {
+                return false;
+            }
+            for (RandomizerCheck check : Rando::StaticData::GetShopLocations()) {
+                if (!Flags_GetRandomizerInf(
+                        OTRGlobals::Instance->gRandomizer->GetRandomizerInfFromCheck(check))) {
+                    continue; // not bought (yet)
+                }
+                const auto itemLocation = randoCtx->GetItemLocation(check);
+                if (itemLocation == nullptr) {
+                    continue;
+                }
+                const auto location = Rando::StaticData::GetLocation(check);
+                if (location == nullptr) {
+                    continue;
+                }
+                if (itemLocation->GetPrice() > location->GetVanillaPrice()) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        case 1006: // Kokiri Sword Shuffle.
+            return RandoContextReady() && RandoSetting(RSK_SHUFFLE_KOKIRI_SWORD) != 0;
+        case 1014: // 100 Skulltulas in a seed.
+            return gSaveContext.inventory.gsTokens >= 100;
+        case 1015: // 20 hearts in a seed.
+            return gSaveContext.healthCapacity == 0x140;
+        case 1016: // All 12 songs in a seed.
+            return CheckAllSongs();
+        case 1017: // All equipment in a seed.
+            return CheckAllEquipment();
+        case 1018: // All 6 medallions + 3 Spiritual Stones in a seed.
+            return CheckAllDungeonRewards();
+        case 1019: // All masks in a seed.
+            return CheckAllMasks();
+        case 1022: // Five Seeds (run #29): 5 Randomizer Ganon wins.
+            // The counter is incremented once per win in Tick's
+            // END_CREDITS block (CountRandoWin); this case is only the
+            // fallback for a counter already at 5 (e.g. a win counted
+            // before this build, or a counter kept across a reset).
+            return CVarGetInteger(kSeedsCompleted, 0) >= 5;
+        case 1023: // Money Solves Everything, Twenty Times — 20 bribes in
+            // Randomizer seeds (200 rupees in total). The counter is
+            // meta-progression (gAchievements.BribeCount, incremented by
+            // Achievements_NotifyBribe on each bribe paid in a seed).
+            return CVarGetInteger(kBribeCount, 0) >= 20;
+        default:
+            return false;
+    }
+}
+
+// Win achievements (1002, 1008, 1010, 1011, 1012, 1020): checked in Tick()
+// before the save-loaded gate, like #31. Caller guarantees END_CREDITS
+// and IS_RANDO. The timestamps are the discriminator (see the section
+// comment above): a Triforce Hunt win sets TIMESTAMP_TRIFORCE_COMPLETED
+// and NOT TIMESTAMP_DEFEAT_GANON, so it unlocks only 1010.
+static bool CheckRandoWin(int id) {
+    switch (id) {
+        case 1002: // Seed Beater — beat Ganon in a seed.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] != 0;
+        case 1008: { // Increased Damage — beat Ganon with damage x2 or more.
+            if (gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] == 0 ||
+                !RandoContextReady()) {
+                return false;
+            }
+            // Explicit comparisons, not >= : the damage enum order is
+            // verified (HALF, DEFAULT, DOUBLE, QUADRUPLE, OCTUPLE,
+            // SEXDECUPLE, OHKO) but >= on the enum relies on it staying
+            // sequential, so spell out every value >= DOUBLE.
+            const u8 damage = RandoSetting(RSK_DAMAGE_MULTIPLIER);
+            return damage == RO_DAMAGE_MULTIPLIER_DOUBLE ||
+                   damage == RO_DAMAGE_MULTIPLIER_QUADRUPLE ||
+                   damage == RO_DAMAGE_MULTIPLIER_OCTUPLE ||
+                   damage == RO_DAMAGE_MULTIPLIER_SEXDECUPLE || damage == RO_DAMAGE_MULTIPLIER_OHKO;
+        }
+        case 1010: // Wisdom, Power and Courage — Triforce Hunt win.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_TRIFORCE_COMPLETED] != 0;
+        case 1011: // Praise the Sun (run #29) — beat Ganon without dying
+            // once. deaths is reset to 0 on a new file (SaveManager) and
+            // incremented on every game over, so 0 at the win means the
+            // whole seed was deathless.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] != 0 &&
+                   gSaveContext.deaths == 0;
+        case 1012: // Gotta Go Fast (run #29) — beat Ganon in under 5 hours.
+            // TIMESTAMP_DEFEAT_GANON holds GAMEPLAYSTAT_TOTAL_TIME in
+            // TENTHS of a second (gameplaystats.h); 5 h = 180000 tenths.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] != 0 &&
+                   gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] < 180000;
+        case 1020: // Heartless — beat Ganon with 3 hearts, no containers.
+            // healthCapacity 0x30 = 3 hearts: no containers (each +0x10)
+            // and no heart pieces (4 pieces = +0x10) can have been taken.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] != 0 &&
+                   gSaveContext.healthCapacity == 0x30;
+        default:
+            return false;
+    }
+}
