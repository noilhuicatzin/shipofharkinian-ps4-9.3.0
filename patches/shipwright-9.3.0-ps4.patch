+// game uses it whenever the manual seed field is empty. Missing or empty file
+// keeps the stock behaviour: a random seed.
+static std::string ReadSeedFile() {
+    std::ifstream file(Ship::Context::GetPathRelativeToAppDirectory("seed.txt"));
+    if (!file.is_open()) {
+        return "";
+    }
+    std::string line;
+    std::getline(file, line);
+    // Keep only alphanumerics (the Seed field's FilterAlphaNum) and cap at the
+    // field's limit, so a trailing newline or stray characters can't break it.
+    std::string seed;
+    for (char c : line) {
+        if (std::isalnum(static_cast<unsigned char>(c))) {
+            seed.push_back(c);
+        }
+        if (seed.size() >= MAX_SEED_STRING_SIZE - 1) {
+            break;
+        }
+    }
+    return seed;
+}
