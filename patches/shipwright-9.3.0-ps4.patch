+        const bool active = (lang == buttons[i].value);
+        ImGui::PushStyleColor(ImGuiCol_Button, active ? kPalGold : ImVec4(0, 0, 0, 0));
+        ImGui::PushStyleColor(ImGuiCol_ButtonHovered,
+                              active ? ImVec4(1.0f, 0.83f, 0.35f, 1.0f) : ImVec4(0.25f, 0.28f, 0.34f, 1.0f));
