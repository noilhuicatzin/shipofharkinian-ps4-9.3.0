+        if (seed.empty()) {
+            SPDLOG_INFO("[PS4] [diag] rando seed: no seed in seed.txt, random seed");
+        } else {
+            SPDLOG_INFO("[PS4] [diag] rando seed from seed.txt: '{}'", seed);
+        }
+    }
+    return seed;
+}
