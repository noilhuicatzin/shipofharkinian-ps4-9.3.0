+};
+
+// Last achievements language applied to the stored widget names (-1 = none yet).
+static int sAppliedAchievementsLanguage = -1;
+
+void SohMenu::UpdateAchievementsLanguage() {
+    if (!mMenuElementsInitialized) {
+        return;
+    }
+    const int language = Achievements::Language();
+    if (language == sAppliedAchievementsLanguage) {
+        return;
+    }
+    auto it = menuEntries.find("Logros");
+    if (it == menuEntries.end()) {
+        return;
+    }
+    for (auto& [sidebarName, sidebar] : it->second.sidebars) {
+        for (auto& column : sidebar.columnWidgets) {
+            for (WidgetInfo& widget : column) {
