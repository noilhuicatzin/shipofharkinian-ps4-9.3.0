+// Rewards header (run #30): title + unseen dot, Triforce, progress,
+// points, rank card, slot pips, milestone ladder, secret letter.
+// ---------------------------------------------------------------------------
+static void DrawTriforce(ImDrawList* dl, ImVec2 origin, float side, int pieces) {
+    // 3 triangles (top, bottom-left, bottom-right), gold when earned.
+    const float h = side * 0.866f;
+    const ImVec2 tris[3][3] = {
+        { { origin.x + side, origin.y },
+          { origin.x + side * 0.5f, origin.y + h },
+          { origin.x + side * 1.5f, origin.y + h } },
+        { { origin.x + side * 0.5f, origin.y + h },
+          { origin.x, origin.y + 2 * h },
+          { origin.x + side, origin.y + 2 * h } },
+        { { origin.x + side * 1.5f, origin.y + h },
+          { origin.x + side, origin.y + 2 * h },
+          { origin.x + side * 2.0f, origin.y + 2 * h } },
+    };
+    for (int i = 0; i < 3; i++) {
+        if (i < pieces) {
+            dl->AddTriangleFilled(tris[i][0], tris[i][1], tris[i][2], ImGui::GetColorU32(kPalGold));
+        } else {
+            dl->AddTriangleFilled(tris[i][0], tris[i][1], tris[i][2],
+                                  ImGui::GetColorU32(ImVec4(0.16f, 0.18f, 0.22f, 1.0f)));
+            dl->AddTriangle(tris[i][0], tris[i][1], tris[i][2], ImGui::GetColorU32(kPalDim), 1.0f);
+        }
+    }
+}
