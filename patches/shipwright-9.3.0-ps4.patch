+// ---------------------------------------------------------------------------
+// Unlock + toast
+// ---------------------------------------------------------------------------
+// Toast visibility, read by the PS4 touchpad shortcut (libultraship):
+// 1 while an achievement toast is on screen, 0 otherwise. A counter, not a
+// plain flag, so two toasts stacked in consecutive ticks don't clear the
+// flag early when the first one expires. The flag is set on emit and cleared
+// by Notification's onDismiss hook, which fires on the real expiry (or on
+// the action-button dismiss), never on a guessed timer.
+static int sVisibleToasts = 0;
+static void SetToastVisible(bool visible) {
+    if (visible) {
+        ++sVisibleToasts;
+    } else if (sVisibleToasts > 0) {
+        --sVisibleToasts;
+    }
+    CVarSetInteger(kToastVisible, sVisibleToasts > 0 ? 1 : 0);
+}
+
+static void EmitUnlockToast(const std::vector<const Def*>& newlyUnlocked, bool firstEver) {
+    const std::string viewLabel = Tr("View in Achievements", "Ver en Logros");
+    auto openLogros = []() { OpenLogrosMenu(); };
+    // Every branch below emits exactly one toast.
+    SetToastVisible(true);
+    auto onToastDismissed = []() { SetToastVisible(false); };
+
+    if (firstEver) {
+        // Special notice on the first unlock ever.
+        int points = 0;
+        for (const Def* def : newlyUnlocked) {
+            points += def->points;
+        }
+        std::string message;
+        if (newlyUnlocked.size() == 1) {
+            message = Title(*newlyUnlocked.front());
+        } else if (IsSpanish()) {
+            message = spdlog::fmt_lib::format("{} logros nuevos", newlyUnlocked.size());
+        } else {
+            message = spdlog::fmt_lib::format("{} new achievements", newlyUnlocked.size());
+        }
+        Notification::Emit({
+            .itemIcon = newlyUnlocked.front()->icon,
+            .prefix = Tr("First achievement!", "¡Primer logro!"),
+            .message = message,
+            .suffix = spdlog::fmt_lib::format("+{} pts", points),
+            .actionLabel = viewLabel,
+            .action = openLogros,
+            .onDismiss = onToastDismissed,
+        });
+        return;
+    }
+
+    if (newlyUnlocked.size() == 1) {
+        const Def* def = newlyUnlocked.front();
+        Notification::Emit({
+            .itemIcon = def->icon,
+            .prefix = Tr("Achievement unlocked!", "¡Logro desbloqueado!"),
+            .message = Title(*def),
+            .suffix = spdlog::fmt_lib::format("+{} pts", def->points),
+            .actionLabel = viewLabel,
+            .action = openLogros,
+            .onDismiss = onToastDismissed,
+        });
+        return;
+    }
+
+    // Several unlocked in the same tick (e.g. loading an old save): one
+    // summary toast instead of a stack of them.
+    int points = 0;
+    for (const Def* def : newlyUnlocked) {
+        points += def->points;
+    }
+    const std::string summary =
+        IsSpanish() ? spdlog::fmt_lib::format("{} logros nuevos", newlyUnlocked.size())
+                    : spdlog::fmt_lib::format("{} new achievements", newlyUnlocked.size());
+    Notification::Emit({
+        .prefix = Tr("Achievements unlocked!", "¡Logros desbloqueados!"),
+        .message = summary,
+        .suffix = spdlog::fmt_lib::format("+{} pts", points),
+        .actionLabel = viewLabel,
+        .action = openLogros,
+        .onDismiss = onToastDismissed,
+    });
+}
