+        ImGui::PopTextWrapPos();
+        ImGui::SetCursorPosY(cardH - pad - 26.0f);
+        if (DrawSwitchButton("##switch", on)) {
+            CVarSetInteger((std::string("gAchievements.Reward.") + card.suffix).c_str(), on ? 0 : 1);
+            SaveAchievementsCvars();
+        }
+        ImGui::SameLine();
+        ImGui::TextColored(on ? kPalGold : kPalMuted, "%s", on ? "ON" : "OFF");
+        ImGui::EndChild();
+        ImGui::PopStyleVar();
+        ImGui::PopStyleColor(2);
+        ImGui::PopID();
+        if (i % cols == cols - 1) {
+            ImGui::Dummy(ImVec2(0, spacingY * 0.5f));
+        }
+    }
