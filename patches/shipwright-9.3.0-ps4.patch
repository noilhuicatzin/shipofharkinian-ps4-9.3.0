+// #1001 Not Vanilla Anymore (run #29): at least one .o2r mod is mounted.
+// The ResourceManager mounts every .o2r/.zip/.otr/.mpq in <appdir>/mods
+// as an archive (Context.cpp, mPatchesPath). A mod archive's path
+// contains "/mods/" (the existing IsCustomArchive pattern in
+// DynamicCosmeticsEditor.cpp) and ends in ".o2r"; the base oot.o2r
+// (and oot-mq.o2r) live in <appdir>/, not in mods/. The FolderArchive
+// for the mods dir itself ends in "/mods" (no .o2r), so an empty mods
+// folder cannot false-trigger.
+static bool HasActiveMod() {
+    auto ctx = Ship::Context::GetRawInstance();
+    if (ctx == nullptr) {
+        return false;
+    }
+    auto resourceManager = ctx->GetResourceManager();
+    if (resourceManager == nullptr) {
+        return false;
+    }
+    auto archiveManager = resourceManager->GetArchiveManager();
+    if (archiveManager == nullptr) {
+        return false;
+    }
+    auto archives = archiveManager->GetArchives();
+    if (archives == nullptr) {
+        return false;
+    }
+    for (const auto& archive : *archives) {
+        if (archive == nullptr) {
+            continue;
+        }
+        const std::string& path = archive->GetPath();
+        const bool inMods = path.find("/mods/") != std::string::npos ||
+                            path.find("\\mods\\") != std::string::npos;
+        const bool isO2r = path.size() >= 4 && path.compare(path.size() - 4, 4, ".o2r") == 0;
+        if (inMods && isO2r) {
+            return true;
+        }
+    }
+    return false;
+}
