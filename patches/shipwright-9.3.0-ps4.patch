+                if (entry.sidebarOrder[i] == sectionIndex) {
+                    sectionPos = i;
+                    break;
+                }
+            }
+            current = total + sectionPos;
+        }
+        total += static_cast<int>(entry.sidebarOrder.size());
+    }
+    if (total <= 1 || current < 0) {
+        return;
+    }
+    int next = (current + dir) % total;
+    if (next < 0) {
+        next += total;
+    }
+    int remaining = next;
+    for (const std::string& header : menuOrder) {
+        auto it = menuEntries.find(header);
+        if (it == menuEntries.end()) {
+            continue;
+        }
+        const MainMenuEntry& entry = it->second;
+        const int count = static_cast<int>(entry.sidebarOrder.size());
+        if (remaining < count) {
+            CVarSetString(headerCvar, header.c_str());
+            CVarSetString(entry.sidebarCvar, entry.sidebarOrder[remaining].c_str());
+            CVarSave();
+            // TEMP DIAG: proves the section switch on console (dir: +1 = next
+            // section = visually down, -1 = previous = visually up).
+            SPDLOG_INFO("[PS4] [diag] menu section -> {} / {} (dir {})", header, entry.sidebarOrder[remaining],
+                        dir);
+            spdlog::default_logger()->flush();
+            return;
+        }
+        remaining -= count;
+    }
+}
