+// ---------------------------------------------------------------------------
+// Detection (phase 3, run #20: the 13 easy Randomizer achievements)
+// Every condition verified against the real 9.3.0 source.
+// * A seed is loaded when IS_RANDO (the save's quest id,
+//   soh/include/z64save.h:413). Every in-seed achievement is gated on it,
+//   so vanilla play can never unlock a Randomizer achievement.
+// * The seed's settings live in Rando::Context::mOptions and are read via
+//   OTRGlobals::Instance->gRandomizer->GetRandoSettingValue: at generation
+//   the menu settings are copied into the Context
+//   (Settings::SetAllToContext, randomizer.cpp), and when a save is loaded
+//   the spoiler file restores them (Settings::ParseJson via
+//   Randomizer_ParseSpoiler at file select), so they describe the seed
+//   being played, not the menu. The seed-context guard
+//   (IsSeedGenerated || IsSpoilerLoaded) keeps stale options from a
+//   previous seed in the same session from unlocking anything when the
+//   spoiler file is missing.
+// * The win achievements (1002, 1008, 1010, 1020) are checked in Tick()
+//   before the save-loaded gate, like #31 (END_CREDITS), with the win
+//   timestamps as the discriminator: TIMESTAMP_DEFEAT_GANON is set only
+//   by the Ganon boss-defeat hook (BossDefeatTimestamps.cpp), and
+//   TIMESTAMP_TRIFORCE_COMPLETED only by the Triforce Hunt warp
+//   (hook_handlers.cpp:2742). A Triforce Hunt win therefore does NOT
+//   unlock "Beat Ganon" (1002/1008/1020), and a Ganon win does NOT unlock
+//   the hunt achievement (1010).
+// * 1017 "all equipment" = the 12 slots of the equipment screen: 3 swords,
+//   3 shields, 3 tunics, 3 boots. (ACHIEVEMENTS.md left the exact set
+//   open; this is the equipment screen.)
+// The other 9 Randomizer achievements are NOT implemented here
+// (1001 mods, 1005 sobreprecio, 1007 llave fuera, 1009 Boss Rush,
+// 1011 sin morir, 1012 menos de 5 h, 1013 recompensa fuera, 1021 Boss
+// Rush sin daño, 1022 cinco seeds): they need live tracking or mods.
+// ---------------------------------------------------------------------------
+static bool RandoContextReady() {
+    auto ctx = Rando::Context::GetInstance();
+    return ctx != nullptr && (ctx->IsSeedGenerated() || ctx->IsSpoilerLoaded());
+}
+
+static u8 RandoSetting(RandomizerSettingKey key) {
+    if (OTRGlobals::Instance == nullptr || OTRGlobals::Instance->gRandomizer == nullptr) {
+        return 0;
+    }
+    return OTRGlobals::Instance->gRandomizer->GetRandoSettingValue(key);
+}
