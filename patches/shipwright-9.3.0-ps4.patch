+static void DrawVanillaList(WidgetInfo&) {
+    // Opening the list marks the new unlocks as seen (clears the badge).
+    Achievements::MarkSeen();
+
+    ImGui::Text("%s",
+                Achievements::Tr(
+                    spdlog::fmt_lib::format("Achievements: {}/{}  ·  Points: {}/{}",
+                                            Achievements::CategoryUnlockedCount(Achievements::Category::Vanilla),
+                                            Achievements::CategoryTotalCount(Achievements::Category::Vanilla),
+                                            Achievements::CategoryUnlockedPoints(Achievements::Category::Vanilla),
+                                            Achievements::CategoryPoints(Achievements::Category::Vanilla)),
+                    spdlog::fmt_lib::format("Logros: {}/{}  ·  Puntos: {}/{}",
+                                            Achievements::CategoryUnlockedCount(Achievements::Category::Vanilla),
+                                            Achievements::CategoryTotalCount(Achievements::Category::Vanilla),
+                                            Achievements::CategoryUnlockedPoints(Achievements::Category::Vanilla),
+                                            Achievements::CategoryPoints(Achievements::Category::Vanilla)))
+                    .c_str());
+    ImGui::Separator();
+    for (const Achievements::Def& def : Achievements::GetDefs()) {
+        if (def.category != Achievements::Category::Vanilla) {
