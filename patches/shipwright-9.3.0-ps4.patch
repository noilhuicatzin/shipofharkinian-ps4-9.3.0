+static void ArmFight(int bossActorId) {
+    sFight = FightTracker{};
+    sFight.armed = true;
+    sFight.bossActorId = bossActorId;
+}
+
+static void DisarmFight() {
+    sFight = FightTracker{};
+}
+
+// Polls the live fight state. Called every frame from Tick()'s unthrottled
+// part (before the 30-frame throttle), so transient signals (a one-frame
+// lens flash, a healthAccumulator drain) are never missed.
+static void UpdateFightTracker() {
+    if (!sFight.armed) {
+        return;
+    }
+    PlayState* play = gPlayState;
+    if (play == nullptr || !GameInteractor::IsSaveLoaded()) {
+        DisarmFight();
+        return;
+    }
+    // Left the boss scene (warp out, etc.): the fight is over.
+    if (!IsBossScene(play->sceneNum)) {
+        DisarmFight();
+        return;
+    }
+    Player* player = GET_PLAYER(play);
+    if (player == nullptr) {
+        return;
+    }
+    // Baseline once the player is out of the intro cutscene (see the
+    // section comment: skips Zelda's full heal before Ganondorf).
+    if (!sFight.baselined) {
+        if (player->stateFlags1 & PLAYER_STATE1_IN_CUTSCENE) {
+            return;
+        }
+        sFight.baselined = true;
+        sFight.fairyCount = CountFairies();
+        sFight.bombAmmo = AMMO(ITEM_BOMB);
+        sFight.bombchuAmmo = AMMO(ITEM_BOMBCHU);
+        sFight.lastHealth = gSaveContext.health;
+        return;
+    }
+    // Health: any decrease = damage, any increase = heal. Polling every
+    // frame catches healthAccumulator drains (bottle heals) that never
+    // fire OnPlayerHealthChange.
+    const int health = gSaveContext.health;
+    if (health < sFight.lastHealth) {
+        sFight.tookDamage = true;
+    } else if (health > sFight.lastHealth) {
+        sFight.healed = true;
+    }
+    sFight.lastHealth = health;
+    // Fairies: a used fairy leaves its bottle (ITEM_FAIRY -> ITEM_BOTTLE).
+    if (const int fairies = CountFairies(); fairies < sFight.fairyCount) {
+        sFight.fairyUsed = true;
+        sFight.fairyCount = fairies;
+    }
+    // Bombs / bombchus: ammo only decreases by use.
+    // (Run #29: track bag bombs separately from bombchus — #6 forbids
+    // only "Bombs from your bag", while bombUsed (both) is #30's rule.)
+    if (AMMO(ITEM_BOMB) < sFight.bombAmmo) {
+        sFight.bombUsed = true;
+        sFight.bagBombUsed = true;
+        sFight.bombAmmo = AMMO(ITEM_BOMB);
+    }
+    if (AMMO(ITEM_BOMBCHU) < sFight.bombchuAmmo) {
+        sFight.bombUsed = true;
+        sFight.bombchuAmmo = AMMO(ITEM_BOMBCHU);
+    }
+    // Boss health, polled for #13 only (Phantom Ganon: unlock when his
+    // health reaches 2 — RA's "1 HP", 30 health = 15 HP, -2 per arrow —
+    // with only bow damage so far). The boss actor is found by scanning
+    // the boss list each frame (cheap: 1-3 actors); storing the pointer
+    // at ArmFight would go stale on a re-entry. The latch is STICKY on
+    // purpose: once he is down to 1 HP on bow damage alone, the feat is
+    // earned — the killing blow is always a sword hit (at health 2 only
+    // canKill damage lands), and it must not revoke it. The `found` guard
+    // matters: bossHealth starts at 0, which is <= 2, so an unfound actor
+    // must never trip the check.
+    if (sFight.bossActorId == ACTOR_BOSS_GANONDROF) {
+        bool found = false;
+        for (Actor* actor = play->actorCtx.actorLists[ACTORCAT_BOSS].head; actor != nullptr;
+             actor = actor->next) {
+            if (actor->id == ACTOR_BOSS_GANONDROF) {
+                sFight.bossHealth = actor->colChkInfo.health;
+                found = true;
+                break;
+            }
+        }
+        if (found && sFight.bossHealth <= 2 && !sFight.nonArrowHit) {
+            sHookFired[13] = true;
+        }
+    }
+    // Grabbed by an enemy (Morpha tentacle, Bongo Bongo hand).
+    if (player->stateFlags2 & PLAYER_STATE2_GRABBED_BY_ENEMY) {
+        sFight.grabbed = true;
+    }
+    // In water (Morpha room). Swimming is persistent, so polling catches it.
+    if (player->stateFlags1 & PLAYER_STATE1_IN_WATER) {
+        sFight.inWater = true;
+    }
+    // Lens of Truth active (Bongo Bongo). Transient — polled every frame.
+    if (play->actorCtx.lensActive) {
+        sFight.lensUsed = true;
+    }
+    // Fell off the platform. Twinrova: platforms at 230/240, floor at 35,
+    // so Y < 200 means down on the floor. Ganondorf: platforms at y=0;
+    // Y < -1 allows float noise and still catches any real fall (and a
+    // sinking platform, which also lowers Y — defensible per "sin caer").
+    const float y = player->actor.world.pos.y;
+    if (sFight.bossActorId == ACTOR_BOSS_TW) {
+        if (y < 200.0f) {
+            sFight.fell = true;
+        }
+    } else if (sFight.bossActorId == ACTOR_BOSS_GANON) {
+        if (y < -1.0f) {
+            sFight.fell = true;
+        }
+    }
+    ++sFight.frames;
+}
+
+// Run #29: the scene of the last boss defeated (boss room), for #1013
+// (dungeon reward outside its dungeon). Medallions are awarded in the
+// Chamber of Sages, not in the boss room, so the reward's source dungeon
+// is the last boss's dungeon, not the scene where the bit appears.
+// Recorded for EVERY boss defeat (before the tracker-armed check below),
+// -1 when no boss has been defeated yet this session.
+static int sLastBossDefeatScene = -1;
+
+// Evaluates the fight achievements for the boss that just died. The
+// OnBossDefeat hook fires on the killing blow (same frame), before the
+// death cutscene and before any post-fight healing, so gSaveContext.read
+// here is the state at the moment of the win. Latches sHookFired; Tick()
+// does the unlock + toast.
+static void EvaluateBossDefeat(int bossActorId) {
+    // Run #29: record the defeat scene first (for #1013), even if the
+    // tracker never armed for this boss — the reward source is the last
+    // boss defeated, tracked or not.
+    if (gPlayState != nullptr) {
+        sLastBossDefeatScene = gPlayState->sceneNum;
+    }
+    // Only judge a fight we actually tracked. (If the tracker never armed
+    // — e.g. the boss died without its OnActorInit firing — there is
+    // nothing reliable to judge, so nothing unlocks.)
+    if (!sFight.armed || sFight.bossActorId != bossActorId) {
+        return;
+    }
+    switch (bossActorId) {
+        case ACTOR_BOSS_GOMA: // Queen Gohma (run #29)
+            // #1 Spider Net: defeated before she retreated to the ceiling.
+            // The retreat is latched by Achievements_NotifyGohmaRetreat
+            // (BossGoma_SetupWallClimb). She starts on the ceiling and
+            // only climbs after dropping to the floor, so a latch means
+            // she got away at least once.
+            if (!sFight.gohmaRetreated) {
+                sHookFired[1] = true;
+            }
+            break;
+        case ACTOR_BOSS_DODONGO: // King Dodongo (run #29)
+            // #6 Bombalicious: defeated before his first fire breath, and
+            // without using Bombs from the bag (bombchus are allowed — the
+            // "bag" is ITEM_BOMB only, tracked as bagBombUsed; bombUsed
+            // combines both and belongs to #30).
+            if (!sFight.dodongoBreathedFire && !sFight.bagBombUsed) {
+                sHookFired[6] = true;
+            }
+            break;
+        case ACTOR_BOSS_VA: // Barinade
+            // #8 Rolling Thunder: no damage taken.
+            if (!sFight.tookDamage) {
+                sHookFired[8] = true;
+            }
+            // #93 Race Against the Clock: < 1:51 (2220 ticks at 20 Hz) with 3 hearts.
+            if (sFight.frames < 2220 && gSaveContext.healthCapacity == 0x30) {
+                sHookFired[93] = true;
+            }
+            break;
+        case ACTOR_BOSS_FD2: // Volvagia
+            // #15 Hot Hot Hot: without the Goron Tunic equipped.
+            if (CUR_EQUIP_VALUE(EQUIP_TYPE_TUNIC) != EQUIP_VALUE_TUNIC_GORON) {
+                sHookFired[15] = true;
+            }
+            // #95 Whac-A-Mole (run #29): only the Megaton Hammer damaged
+            // him (latched by Achievements_NotifyBossHit in
+            // BossFd2_CollisionCheck), no healing, 3 hearts.
+            if (!sFight.nonHammerHit && !sFight.healed &&
+                gSaveContext.healthCapacity == 0x30) {
+                sHookFired[95] = true;
+            }
+            break;
+        case ACTOR_BOSS_MO: // Morpha
+            // #19 Day of the Tentacles: never grabbed, never in the water.
+            if (!sFight.grabbed && !sFight.inWater) {
+                sHookFired[19] = true;
+            }
+            // #96 Tentacles of the Deep: #19 + no damage + 3 hearts.
+            if (!sFight.grabbed && !sFight.inWater && !sFight.tookDamage &&
+                gSaveContext.healthCapacity == 0x30) {
+                sHookFired[96] = true;
+            }
+            break;
+        case ACTOR_BOSS_SST: // Bongo Bongo
+            // #21 Invisible One: never used the Lens, never grabbed.
+            if (!sFight.lensUsed && !sFight.grabbed) {
+                sHookFired[21] = true;
+            }
+            // #97 Invisible Stalker: #21 + no healing + 3 hearts.
+            if (!sFight.lensUsed && !sFight.grabbed && !sFight.healed &&
+                gSaveContext.healthCapacity == 0x30) {
+                sHookFired[97] = true;
+            }
+            break;
+        case ACTOR_BOSS_TW: // Twinrova
+            // #26 Twins of Evil, redefined by Lux (2026-11-17) as
+            // "without falling from the platform" only. The "12 s revival
+            // window" does not exist in the code (the sisters are born
+            // with health 0; each reflected beam hit does
+            // otherTw->health++, and the sum >= 4 merges them), so the
+            // revive clause was dropped; the fall clause is sFight.fell
+            // (Y < 200 here, set in UpdateFightTracker).
+            if (!sFight.fell) {
+                sHookFired[26] = true;
+            }
+            // #98 Double Trouble (run #29): only the Master Sword damaged
+            // the merged form (latched by Achievements_NotifyBossHit in
+            // the stunned branch of the Twinrova collision check — the
+            // Mirror Shield's reflected beam only stuns, it deals no
+            // health damage), no fairy used, 3 hearts.
+            if (!sFight.nonMasterSwordHit && !sFight.fairyUsed &&
+                gSaveContext.healthCapacity == 0x30) {
+                sHookFired[98] = true;
+            }
+            break;
+        case ACTOR_BOSS_GANONDROF: // Phantom Ganon (run #29)
+            // No verdict here on purpose: #13 is judged live by the
+            // health poll in UpdateFightTracker (it must fire when his
+            // health reaches 2, before the killing sword blow), and #94
+            // has no detection at all (pre-existing gap from run #23:
+            // marked implemented but never wired — see run29-progress.md,
+            // NOT fixed in this run).
+            break;
+        case ACTOR_BOSS_GANON: // Ganondorf
+            // #29 King of Thieves: never fell off the platform, no fairy used.
+            if (!sFight.fell && !sFight.fairyUsed) {
+                sHookFired[29] = true;
+            }
+            break;
+        case ACTOR_BOSS_GANON2: // Ganon
+            // #30 My Last Breath: <= 1 heart left, no fairy, no bombs.
+            // "No bombs" includes bombchus (they are bombs).
+            if (gSaveContext.health <= 0x10 && !sFight.fairyUsed && !sFight.bombUsed) {
+                sHookFired[30] = true;
+            }
+            // #99 Dark Lord: no damage taken, 3 hearts.
+            if (!sFight.tookDamage && gSaveContext.healthCapacity == 0x30) {
+                sHookFired[99] = true;
+            }
+            break;
+        default:
+            break;
+    }
+    DisarmFight();
+}
