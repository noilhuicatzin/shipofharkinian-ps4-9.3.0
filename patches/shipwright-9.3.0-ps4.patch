+// ---------------------------------------------------------------------------
+// Runtime hook events + fight tracker (phase 3, run #23: the 17 HOOK
+// achievements; #46 stays pending — see the notes in the registry
+// and in EvaluateBossDefeat / hook-run23-progress.md).
+//
+// Two kinds of runtime signal, one latch:
+//   * Direct calls from actor code (Heishi2 bribe #35, cow milk #38,
+//     Hyrule Loach #90) via Achievements_NotifyHook().
+//   * GameInteractor hooks registered here: OnActorInit arms the fight
+//     tracker when a boss spawns, OnBossDefeat evaluates the fight, and
+//     OnActorInit for the attack cucco fires #44 (Cuccos' Revenge).
+// Every signal only latches sHookFired[id]; Tick() turns it into the
+// normal unlock + toast on its own path (CheckCondition reads the latch
+// first), so all unlock logic stays in one place and nothing here writes
+// a CVar or a toast from inside an actor update.
+//
+// Fight tracker design (verified against the real 9.3.0 code):
+//   * Arming: OnActorInit of the boss actor, once per spawn. Re-entering
+//     a boss room after a death re-arms (fresh flags), so a failed attempt
+//     never poisons the next one.
+//   * Baselines: snapshotted on the first frame the player is out of the
+//     intro cutscene. This skips Zelda's full heal before Ganondorf
+//     (z_boss_ganon.c) and any intro-only state; damage/heals before the
+//     baselines do not exist (actors are halted during the cutscene).
+//   * Polling: every frame (Tick()'s unthrottled part, 20 Hz logic —
+//     GameState_Update / game.c:357, R_UPDATE_RATE = 3). Health is polled,
+//     not hooked: OnPlayerHealthChange misses bottle heals (the
+//     healthAccumulator drains +4/frame straight into gSaveContext.health
+//     with no hook, z_parameter.c), so any health increase = a heal and
+//     any decrease = damage. Fairies and bombs are polled by count/ammo
+//     (a used fairy leaves its bottle; ammo only decreases by use).
+//   * Verdict: in the OnBossDefeat hook, which fires on the killing blow,
+//     before the death cutscene and before any post-fight healing. The
+//     tracker is disarmed right after the verdict.
+//   * Timer (#93, Barinade < 1:51 with 3 hearts): frames counted from the
+//     baselines to the defeat, 20 ticks/s, so 111 s = 2220 ticks. Frame
+//     counting (not GAMEPLAYSTAT_TOTAL_TIME) because the time macro freezes
+//     at the Ganon defeat timestamp once the game is complete, which would
+//     false-positive #93 on any later Barinade replay / Boss Rush.
+// ---------------------------------------------------------------------------
+static bool sHookFired[1024] = {};
+
+extern "C" void Achievements_NotifyHook(int achievementId) {
+    if (achievementId > 0 && achievementId < 1024) {
+        sHookFired[achievementId] = true;
+    }
+}
+
+// Bribe counter for #1023 (Randomizer: bribe the guard 20 times, 200
+// rupees in total — the pair of vanilla #35). Called from the same Heishi2
+// bribe site as NotifyHook(35). The counter is meta-progression (a CVar,
+// so it persists across saves and seeds) and counts ONLY bribes paid
+// while a Randomizer seed is loaded (IS_RANDO), so vanilla bribes never
+// count toward it. CheckRandomizer(1023) unlocks at 20.
+static const char* kBribeCount = "gAchievements.BribeCount";
+extern "C" void Achievements_NotifyBribe() {
+    if (!IS_RANDO) {
+        return;
+    }
+    CVarSetInteger(kBribeCount, CVarGetInteger(kBribeCount, 0) + 1);
+    SaveNow();
+}
+
+void ResetAll() {
+    // Run #26 (Lux): "Reiniciar logros" (menu option, with confirmation).
+    // Destructive: clears EVERY unlock, EVERY reveal, the unseen badge
+    // and the bribe counter (gAchievements.BribeCount) — without the
+    // counter, #1023 would re-unlock on the first bribe after the reset.
+    // Language and reward toggles are settings, not progress: untouched.
+    // The registry does not change (still 98/113 implemented, 800/1005).
+    for (const Def& def : kDefs) {
+        CVarSetInteger(UnlockedCVar(def.id).c_str(), 0);
+        CVarSetInteger(RevealedCVar(def.id).c_str(), 0);
+    }
+    CVarSetInteger(kHasUnseen, 0);
+    CVarSetInteger(kBribeCount, 0);
+    SaveNow();
+    // TEMP DIAG: proves the reset ran on console (and how many defs).
+    SPDLOG_INFO("[PS4] [diag] achievements reset ({} defs cleared, bribes 0)", kDefs.size());
+    spdlog::default_logger()->flush();
+}
+
+struct FightTracker {
+    bool armed = false;      // a boss actor spawned (fight may still be in intro)
+    bool baselined = false;  // baselines snapshotted (player out of cutscene)
+    int bossActorId = 0;
+    bool tookDamage = false; // health decreased at any point in the fight
+    bool healed = false;     // health increased at any point in the fight
+    bool fairyUsed = false;  // a fairy left its bottle
+    bool bombUsed = false;   // bomb or bombchu ammo decreased
+    bool grabbed = false;    // PLAYER_STATE2_GRABBED_BY_ENEMY seen (tentacle/hand)
+    bool inWater = false;    // PLAYER_STATE1_IN_WATER seen (Morpha room)
+    bool fell = false;       // player Y below the platform threshold
+    bool lensUsed = false;   // play->actorCtx.lensActive seen (Bongo Bongo)
+    int fairyCount = 0;
+    int bombAmmo = 0;
+    int bombchuAmmo = 0;
+    int lastHealth = 0;
+    int frames = 0; // logic ticks since the baselines (20 Hz; #93 < 2220)
+};
+static FightTracker sFight;
+
+static int CountFairies() {
+    int count = 0;
+    const u8* items = gSaveContext.inventory.items;
+    const u8 bottleSlots[] = { SLOT_BOTTLE_1, SLOT_BOTTLE_2, SLOT_BOTTLE_3, SLOT_BOTTLE_4 };
+    for (u8 slot : bottleSlots) {
+        if (items[slot] == ITEM_FAIRY) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+static bool IsBossScene(int sceneNum) {
+    switch (sceneNum) {
+        case SCENE_JABU_JABU_BOSS:
+        case SCENE_FIRE_TEMPLE_BOSS:
+        case SCENE_WATER_TEMPLE_BOSS:
+        case SCENE_SHADOW_TEMPLE_BOSS:
+        case SCENE_SPIRIT_TEMPLE_BOSS:
+        case SCENE_GANONDORF_BOSS:
+        case SCENE_GANON_BOSS:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static void ArmFight(int bossActorId) {
+    sFight = FightTracker{};
+    sFight.armed = true;
+    sFight.bossActorId = bossActorId;
+}
+
+static void DisarmFight() {
+    sFight = FightTracker{};
+}
+
+// Polls the live fight state. Called every frame from Tick()'s unthrottled
+// part (before the 30-frame throttle), so transient signals (a one-frame
+// lens flash, a healthAccumulator drain) are never missed.
+static void UpdateFightTracker() {
+    if (!sFight.armed) {
+        return;
+    }
+    PlayState* play = gPlayState;
+    if (play == nullptr || !GameInteractor::IsSaveLoaded()) {
+        DisarmFight();
+        return;
+    }
+    // Left the boss scene (warp out, etc.): the fight is over.
+    if (!IsBossScene(play->sceneNum)) {
+        DisarmFight();
+        return;
+    }
+    Player* player = GET_PLAYER(play);
+    if (player == nullptr) {
+        return;
+    }
+    // Baseline once the player is out of the intro cutscene (see the
+    // section comment: skips Zelda's full heal before Ganondorf).
+    if (!sFight.baselined) {
+        if (player->stateFlags1 & PLAYER_STATE1_IN_CUTSCENE) {
+            return;
+        }
+        sFight.baselined = true;
+        sFight.fairyCount = CountFairies();
+        sFight.bombAmmo = AMMO(ITEM_BOMB);
+        sFight.bombchuAmmo = AMMO(ITEM_BOMBCHU);
+        sFight.lastHealth = gSaveContext.health;
+        return;
+    }
+    // Health: any decrease = damage, any increase = heal. Polling every
+    // frame catches healthAccumulator drains (bottle heals) that never
+    // fire OnPlayerHealthChange.
+    const int health = gSaveContext.health;
+    if (health < sFight.lastHealth) {
+        sFight.tookDamage = true;
+    } else if (health > sFight.lastHealth) {
+        sFight.healed = true;
+    }
+    sFight.lastHealth = health;
+    // Fairies: a used fairy leaves its bottle (ITEM_FAIRY -> ITEM_BOTTLE).
+    if (const int fairies = CountFairies(); fairies < sFight.fairyCount) {
+        sFight.fairyUsed = true;
+        sFight.fairyCount = fairies;
+    }
+    // Bombs / bombchus: ammo only decreases by use.
+    if (AMMO(ITEM_BOMB) < sFight.bombAmmo || AMMO(ITEM_BOMBCHU) < sFight.bombchuAmmo) {
+        sFight.bombUsed = true;
+        sFight.bombAmmo = AMMO(ITEM_BOMB);
+        sFight.bombchuAmmo = AMMO(ITEM_BOMBCHU);
+    }
+    // Grabbed by an enemy (Morpha tentacle, Bongo Bongo hand).
+    if (player->stateFlags2 & PLAYER_STATE2_GRABBED_BY_ENEMY) {
+        sFight.grabbed = true;
+    }
+    // In water (Morpha room). Swimming is persistent, so polling catches it.
+    if (player->stateFlags1 & PLAYER_STATE1_IN_WATER) {
+        sFight.inWater = true;
+    }
+    // Lens of Truth active (Bongo Bongo). Transient — polled every frame.
+    if (play->actorCtx.lensActive) {
+        sFight.lensUsed = true;
+    }
+    // Fell off the platform. Twinrova: platforms at 230/240, floor at 35,
+    // so Y < 200 means down on the floor. Ganondorf: platforms at y=0;
+    // Y < -1 allows float noise and still catches any real fall (and a
+    // sinking platform, which also lowers Y — defensible per "sin caer").
+    const float y = player->actor.world.pos.y;
+    if (sFight.bossActorId == ACTOR_BOSS_TW) {
+        if (y < 200.0f) {
+            sFight.fell = true;
+        }
+    } else if (sFight.bossActorId == ACTOR_BOSS_GANON) {
+        if (y < -1.0f) {
+            sFight.fell = true;
+        }
+    }
+    ++sFight.frames;
+}
+
+// Evaluates the fight achievements for the boss that just died. The
+// OnBossDefeat hook fires on the killing blow (same frame), before the
+// death cutscene and before any post-fight healing, so gSaveContext.read
+// here is the state at the moment of the win. Latches sHookFired; Tick()
+// does the unlock + toast.
+static void EvaluateBossDefeat(int bossActorId) {
+    // Only judge a fight we actually tracked. (If the tracker never armed
+    // — e.g. the boss died without its OnActorInit firing — there is
+    // nothing reliable to judge, so nothing unlocks.)
+    if (!sFight.armed || sFight.bossActorId != bossActorId) {
+        return;
+    }
+    switch (bossActorId) {
+        case ACTOR_BOSS_VA: // Barinade
+            // #8 Rolling Thunder: no damage taken.
+            if (!sFight.tookDamage) {
+                sHookFired[8] = true;
+            }
+            // #93 Race Against the Clock: < 1:51 (2220 ticks at 20 Hz) with 3 hearts.
+            if (sFight.frames < 2220 && gSaveContext.healthCapacity == 0x30) {
+                sHookFired[93] = true;
+            }
+            break;
+        case ACTOR_BOSS_FD2: // Volvagia
+            // #15 Hot Hot Hot: without the Goron Tunic equipped.
+            if (CUR_EQUIP_VALUE(EQUIP_TYPE_TUNIC) != EQUIP_VALUE_TUNIC_GORON) {
+                sHookFired[15] = true;
+            }
+            break;
+        case ACTOR_BOSS_MO: // Morpha
+            // #19 Day of the Tentacles: never grabbed, never in the water.
+            if (!sFight.grabbed && !sFight.inWater) {
+                sHookFired[19] = true;
+            }
+            // #96 Tentacles of the Deep: #19 + no damage + 3 hearts.
+            if (!sFight.grabbed && !sFight.inWater && !sFight.tookDamage &&
+                gSaveContext.healthCapacity == 0x30) {
+                sHookFired[96] = true;
+            }
+            break;
+        case ACTOR_BOSS_SST: // Bongo Bongo
+            // #21 Invisible One: never used the Lens, never grabbed.
+            if (!sFight.lensUsed && !sFight.grabbed) {
+                sHookFired[21] = true;
+            }
+            // #97 Invisible Stalker: #21 + no healing + 3 hearts.
+            if (!sFight.lensUsed && !sFight.grabbed && !sFight.healed &&
+                gSaveContext.healthCapacity == 0x30) {
+                sHookFired[97] = true;
+            }
+            break;
+        case ACTOR_BOSS_TW: // Twinrova
+            // #26 Twins of Evil, redefined by Lux (2026-11-17) as
+            // "without falling from the platform" only. The "12 s revival
+            // window" does not exist in the code (the sisters are born
+            // with health 0; each reflected beam hit does
+            // otherTw->health++, and the sum >= 4 merges them), so the
+            // revive clause was dropped; the fall clause is sFight.fell
+            // (Y < 200 here, set in UpdateFightTracker).
+            if (!sFight.fell) {
+                sHookFired[26] = true;
+            }
+            break;
+        case ACTOR_BOSS_GANON: // Ganondorf
+            // #29 King of Thieves: never fell off the platform, no fairy used.
+            if (!sFight.fell && !sFight.fairyUsed) {
+                sHookFired[29] = true;
+            }
+            break;
+        case ACTOR_BOSS_GANON2: // Ganon
+            // #30 My Last Breath: <= 1 heart left, no fairy, no bombs.
+            // "No bombs" includes bombchus (they are bombs).
+            if (gSaveContext.health <= 0x10 && !sFight.fairyUsed && !sFight.bombUsed) {
+                sHookFired[30] = true;
+            }
+            // #99 Dark Lord: no damage taken, 3 hearts.
+            if (!sFight.tookDamage && gSaveContext.healthCapacity == 0x30) {
+                sHookFired[99] = true;
+            }
+            break;
+        default:
+            break;
+    }
+    DisarmFight();
+}
+
+static void RegisterFightHooks() {
+    // Arm the tracker when a boss spawns (once per spawn, including
+    // re-entry after a death). The painting phantoms (ACTOR_BOSS_FD) are
+    // deliberately NOT armed: they spawn mid-fight and would reset the
+    // tracker. Their OnBossDefeat is not listened to either.
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_VA, true, [](void*) { ArmFight(ACTOR_BOSS_VA); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_FD2, true, [](void*) { ArmFight(ACTOR_BOSS_FD2); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_MO, true, [](void*) { ArmFight(ACTOR_BOSS_MO); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_SST, true, [](void*) { ArmFight(ACTOR_BOSS_SST); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_TW, true, [](void*) { ArmFight(ACTOR_BOSS_TW); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_GANON, true, [](void*) { ArmFight(ACTOR_BOSS_GANON); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_GANON2, true, [](void*) { ArmFight(ACTOR_BOSS_GANON2); });
+    // Evaluate the fight when the boss dies (killing blow, same frame).
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_VA, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_VA); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_FD2, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_FD2); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_MO, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_MO); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_SST, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_SST); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_TW, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_TW); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_GANON, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_GANON); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_GANON2, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_GANON2); });
+    // #44 Cuccos' Revenge: an attack cucco (ACTOR_EN_ATTACK_NIW) only ever
+    // spawns as the start of a swarm (z_en_niw.c), so its first init IS the
+    // swarm. Fires before the first peck; the design says "detect the
+    // swarm", so that is the intended signal.
+    COND_ID_HOOK(OnActorInit, ACTOR_EN_ATTACK_NIW, true, [](void*) { sHookFired[44] = true; });
+}
