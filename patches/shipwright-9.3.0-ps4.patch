+        ImGui::PushID(card.suffix);
+        ImGui::PushStyleColor(ImGuiCol_ChildBg, kPalCard);
+        ImGui::PushStyleColor(ImGuiCol_Border, kPalLine);
+        ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, 12.0f);
+        ImGui::BeginChild("##rewardcard", ImVec2(cardW, cardH), ImGuiChildFlags_Border);
+        ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + cardW - 2 * pad);
