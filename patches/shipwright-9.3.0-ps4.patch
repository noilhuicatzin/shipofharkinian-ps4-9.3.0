+// Hidden achievements currently showing the "reveal?" confirmation
+// (in-memory only; resets when the menu closes).
+static std::set<int> gRevealConfirm;
+
+static std::map<int32_t, const char*> achievementLanguages = {
+    { 0, "English" },
+    { 1, "Español" },
+};
+
+static const ImVec4 kColorUnlocked(0.45f, 1.0f, 0.45f, 1.0f);
+static const ImVec4 kColorLocked(0.75f, 0.75f, 0.75f, 1.0f);
+static const ImVec4 kColorDesc(0.55f, 0.55f, 0.55f, 1.0f);
+static const ImVec4 kColorPoints(1.0f, 0.85f, 0.3f, 1.0f);
+
+static void DrawAchievementRow(const Achievements::Def& def) {
+    // One ImGui ID scope per row: without it, the 14 hidden "???" buttons
+    // (13 once one is unlocked or revealed) all share the label "???" and
+    // ImGui reports "13 visible items with conflicting ID" — and a click
+    // can land on the wrong row. This also scopes the Reveal/Cancel
+    // buttons, which share their labels across rows too.
+    ImGui::PushID(def.id);
+    const bool unlocked = Achievements::IsUnlocked(def.id);
+    const bool revealed = Achievements::IsRevealed(def.id);
+    const bool isHidden = def.hidden && !unlocked && !revealed;
+
+    if (isHidden) {
+        // Story achievement: shown as "???" until unlocked. Tapping it
+        // asks for confirmation (spoiler warning) before revealing it.
+        if (ImGui::Button("???")) {
+            if (gRevealConfirm.count(def.id) != 0) {
+                gRevealConfirm.erase(def.id);
+            } else {
+                gRevealConfirm.insert(def.id);
+            }
+        }
+        ImGui::SameLine();
+        ImGui::TextColored(kColorLocked, "? pts");
+        if (gRevealConfirm.count(def.id) != 0) {
+            ImGui::TextColored(kColorDesc, "%s",
+                               Achievements::Tr("This achievement is a story spoiler. Reveal it?",
+                                                "Este logro es un spoiler de la historia. ¿Revelarlo?")
+                                   .c_str());
+            if (ImGui::SmallButton(Achievements::Tr("Reveal", "Revelar").c_str())) {
+                Achievements::Reveal(def.id);
+                gRevealConfirm.erase(def.id);
+            }
+            ImGui::SameLine();
+            if (ImGui::SmallButton(Achievements::Tr("Cancel", "Cancelar").c_str())) {
+                gRevealConfirm.erase(def.id);
+            }
+        } else {
+            ImGui::TextColored(kColorDesc, "%s",
+                               Achievements::Tr("Tap to reveal (spoiler)", "Toca para revelar (spoiler)").c_str());
+        }
+        ImGui::Separator();
+        ImGui::PopID();
+        return;
+    }
+
+    const std::string name = Achievements::Title(def);
+    if (unlocked) {
+        ImGui::TextColored(kColorUnlocked, "%s", name.c_str());
+    } else {
+        ImGui::TextColored(kColorLocked, "%s", name.c_str());
+    }
+    ImGui::SameLine();
+    ImGui::TextColored(kColorPoints, "%d pts", def.points);
+    if (unlocked) {
+        ImGui::SameLine();
+        ImGui::TextColored(kColorUnlocked, "(%s)",
+                           Achievements::Tr("unlocked", "desbloqueado").c_str());
+    }
+    if (!def.implemented) {
+        ImGui::SameLine();
+        ImGui::TextColored(kColorDesc, "(%s)",
+                           Achievements::Tr("coming soon", "próximamente").c_str());
+    }
+    if (def.hidden && revealed && !unlocked) {
+        // Story achievement revealed (name visible) but still locked:
+        // offer a small "Hide" button to put it back to "???" (clears its
+        // Revealed CVar; takes effect on the next frame, no restart).
+        // Unlocked achievements never show it. The row already runs inside
+        // PushID(def.id), so the button ID is unique per row.
+        ImGui::SameLine();
+        if (ImGui::SmallButton(Achievements::Tr("Hide", "Ocultar").c_str())) {
+            Achievements::Hide(def.id);
+        }
+    }
+    ImGui::TextColored(kColorDesc, "%s", Achievements::Desc(def).c_str());
+    ImGui::Separator();
+    ImGui::PopID();
+}
