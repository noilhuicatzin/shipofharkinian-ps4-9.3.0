+// ---------------------------------------------------------------------------
+// Test toast combo (L3+R3): shows a test toast identical in behaviour to a
+// real unlock toast so the touchpad shortcut can be tested on demand,
+// without unlocking anything. Lux asked for this because the next real
+// unlock is hours of play away, and the shortcut can only be tested while
+// a toast is visible.
+// ---------------------------------------------------------------------------
+// The combo is read straight from the SDL game controller (same pattern as
+// OTRGlobals.cpp). On PS4 there is exactly one: the virtual pad, whose
+// LEFTSTICK/RIGHTSTICK buttons PadUpdate feeds from the physical L3/R3.
+// L3/R3 are not bound to any N64 button (Mapper only lists them for
+// display), so the combo conflicts with nothing in-game. The engine already
+// opens this controller (ConnectedPhysicalDeviceManager), and SDL refcounts
+// opens, so this handle is only borrowed: it is never closed here, only
+// dropped and re-scanned if detached.
+static SDL_GameController* sTestPad = nullptr;
+static bool sComboWasDown = false;
+
+// (Re)scan for the first game controller. No close: the engine owns the
+// lifecycle; dropping a detached pointer is enough. Shared by the
+// L3+R3 test combo and the menu D-pad / stick handler below.
+static bool EnsurePad() {
+    if (sTestPad == nullptr || SDL_GameControllerGetAttached(sTestPad) == SDL_FALSE) {
+        sTestPad = nullptr;
+        for (int i = 0; i < SDL_NumJoysticks(); ++i) {
+            if (SDL_IsGameController(i)) {
+                sTestPad = SDL_GameControllerOpen(i);
+                break;
+            }
+        }
+    }
+    return sTestPad != nullptr;
+}
+
+static bool PadButton(SDL_GameControllerButton button) {
+    return EnsurePad() && SDL_GameControllerGetButton(sTestPad, button) != 0;
+}
+
+static int16_t PadAxis(SDL_GameControllerAxis axis) {
+    return EnsurePad() ? SDL_GameControllerGetAxis(sTestPad, axis) : 0;
+}
+
+static bool IsTestComboDown() {
+    return PadButton(SDL_CONTROLLER_BUTTON_LEFTSTICK) &&
+           PadButton(SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+}
+
+static bool IsMenuOpen() {
+    auto gui = Ship::Context::GetRawInstance()->GetWindow()->GetGui();
+    if (gui == nullptr) {
+        return false;
+    }
+    auto menu = gui->GetMenu();
+    return menu != nullptr && menu->IsVisible();
+}
+
+static void CheckTestCombo() {
+    // Rising edge only: one toast per press, not one per frame while held.
+    const bool down = IsTestComboDown();
+    const bool pressed = down && !sComboWasDown;
+    sComboWasDown = down;
+    if (!pressed) {
+        return;
+    }
+    // Only in-game (a save loaded, menu closed) and only when no toast is
+    // already up (a real toast keeps its window).
+    if (!GameInteractor::IsSaveLoaded() || sVisibleToasts > 0) {
+        return;
+    }
+    if (IsMenuOpen()) {
+        return;
+    }
+    EmitTestToast();
+}
+
+// ---------------------------------------------------------------------------
+// Menu zoom, scroll and input priority (run #20, fixed after the console test)
+// The Logros menu is too small on a TV and its scrollbar too thin to grab
+// with the touchpad pointer, so the menu gets: a zoom (the existing
+// ImGui Scale setting), a wider scrollbar, and D-pad / stick scrolling
+// that needs no aiming.
+// * Zoom reuses the existing "ImGui Menu Scaling" setting
+//   (SohMenuSettings.cpp: "ImGuiScale", gSettings.ImGuiScale, 0 Small
+//   0.75x / 1 Normal 1.0x / 2 Large 1.5x / 3 X-Large 2.0x) and its
+//   OTRGlobals::ScaleImGui(). No new CVar, no duplicate setting. D-pad
+//   left/right steps it while the menu is open; the menu visibly resizes
+//   on each step, which is the feedback.
+// * Scroll: the scrollbar is widened to 28 px (at 1.0x scale) while the
+//   menu is open, and D-pad up/down (one notch per press, repeating while
+//   held) plus the left stick (analog) scroll the "Main Menu" window
+//   directly (see below), so it works in every section with no aiming.
+// * Input priority (Lux's principle: the menu wins over gameplay while
+//   open): while the menu is open, game input is blocked through the
+//   ControlDeck block API, so the D-pad cannot leak into gameplay
+//   (notably ItemUnequip.cpp, which unequips items on D-pad). The menu
+//   itself is unaffected: its toggle (BACK) and the R2 pointer click go
+//   through ImGui, not ControlDeck. The block is applied once on the
+//   menu-open transition and released once on close.
+//
+// RUN #20 CONSOLE TEST — why the zoom and scroll did NOT work (root cause):
+// The first version of CheckMenuInput() returned early when the
+// "Menu Controller Navigation" setting (gControlNav) was on, on the
+// assumption that it is off by default on PS4. On Lux's console it is
+// ON, and that is PROVEN, not guessed:
+//   - the D-pad moves ImGui focus between the option boxes, which only
+//     happens when gamepad nav is active (the SDL backend only maps
+//     gamepad buttons to ImGui nav keys when NavEnableGamepad is set,
+//     and Gui::UpdateGamepadNavigation only sets it when gControlNav
+//     is non-zero);
+//   - the touchpad toggle works, and it requires gControlNav in TWO
+//     places: Gui::DrawMenu only toggles on ImGuiKey_GamepadBack when
+//     gControlNav is non-zero, and the backend only feeds that key
+//     when nav is enabled.
+// The checkbox to change it is compiled out on PS4, so Lux cannot turn
+// it off — and it MUST stay on, because the touchpad toggle depends on
+// it. So the early return skipped the zoom and scroll code entirely,
+// while nav kept owning the D-pad (focus movement, useless in Logros).
+// The scrollbar still widened because that line sits before the return.
+// The fix below does NOT touch gControlNav. Instead, while the menu is
+// open it turns ImGui gamepad nav OFF every frame (Tick runs after
+// DrawMenu in the frame — GameState_Draw runs before OnGameFrameUpdate
+// in GameState_Update — so this clear is the last write before the next
+// frame's NewFrame, and nav stays off even though DrawMenu's
+// UpdateGamepadNavigation re-sets the flag), and it takes over the BACK
+// close: with nav off the backend never sets ImGuiKey_GamepadBack, so
+// Gui::DrawMenu cannot close the menu on the touchpad anymore; the
+// close is read straight from the SDL controller here instead. On the
+// menu-close transition nav is re-enabled (only if gControlNav says so),
+// so the next touchpad press still opens the menu through Gui::DrawMenu.
+// The old scroll also had a second, independent flaw: it injected into
+// ImGui::GetIO().MouseWheel, which only scrolls the window UNDER THE
+// POINTER — and the pointer auto-hides after 3 s and is almost never
+// over the list. The new scroll writes the scroll target of the
+// "Main Menu" window (the outer scroller; the section content lives in
+// tall children inside it) directly, so it moves the list no matter
+// where the pointer is.
+// ---------------------------------------------------------------------------
+// Unique block id for the menu (per-caller ids; the input editor uses
+// 95237929). Fits in the uint16 the bridge takes.
+static constexpr uint16_t kMenuInputBlockId = 42424;
+static bool sMenuInputBlocked = false;
+static bool sMenuWasOpen = false;
+// Previous frame's BACK button state, for the rising-edge menu close.
+static bool sBackPrev = false;
+// One-time boot sanity: reset a menu scale stuck at the max (see below).
+static bool sDidZoomSanity = false;
+// Repeat state for the D-pad, per direction group: frames held and the
+// current direction (reset when the direction changes, so a flip steps
+// at once instead of waiting out the old hold).
+static int sZoomHoldFrames = 0;
+static int sZoomDir = 0;
+static int sScrollHoldFrames = 0;
+static int sScrollDir = 0;
+// Frames before the first repeat, then frames between repeats
+// (~0.4 s / ~0.15 s at 60 fps).
+static constexpr int kRepeatDelayFrames = 24;
+static constexpr int kRepeatRateFrames = 9;
+// Scroll amounts (x FontGlobalScale, so they grow with the zoom):
+// one D-pad notch moves ~3 Logros rows; the stick is analog, full
+// deflection ≈ 480 px/s (≈ 8 px/frame at 60 fps).
+static constexpr float kScrollStepPx = 120.0f;
+static constexpr float kScrollStickPxPerFrame = 8.0f;
+
+static bool RepeatStep(int dir, int& holdFrames, int& lastDir) {
+    if (dir == 0) {
+        holdFrames = 0;
+        lastDir = 0;
+        return false;
+    }
+    if (dir != lastDir) {
+        holdFrames = 0;
+        lastDir = dir;
+    }
+    ++holdFrames;
+    return holdFrames == 1 || (holdFrames > kRepeatDelayFrames &&
+                               (holdFrames - kRepeatDelayFrames) % kRepeatRateFrames == 0);
+}
+
+static void CheckMenuInput() {
+    // One-time boot sanity: if the menu scale is stuck at the max
+    // (X-Large, 2.0x), Lux cannot see the options and the D-pad zoom is
+    // the way back — never boot into an unusable menu. Only the max is
+    // reset; 1.5x is a legitimate choice and is left alone. He can set
+    // it big again from Settings -> General -> ImGui Menu Scaling (and
+    // the D-pad zoom below now works to change it back).
+    if (!sDidZoomSanity) {
+        sDidZoomSanity = true;
+        if (CVarGetInteger(CVAR_SETTING("ImGuiScale"), 1) == 3) {
+            CVarSetInteger(CVAR_SETTING("ImGuiScale"), 1);
+            OTRGlobals::Instance->ScaleImGui();
+        }
+    }
+
+    bool menuOpen = IsMenuOpen();
+
+    // --- input priority: block game input while the menu is open ---
+    if (menuOpen && !sMenuWasOpen) {
+        ControllerBlockGameInput(kMenuInputBlockId);
+        sMenuInputBlocked = true;
+        // The BACK pulse that just opened the menu is still active for a
+        // frame or two; seed the previous state so it does not read as a
+        // fresh press and close the menu again at once.
+        sBackPrev = PadButton(SDL_CONTROLLER_BUTTON_BACK);
+    } else if (!menuOpen && sMenuWasOpen && sMenuInputBlocked) {
+        ControllerUnblockGameInput(kMenuInputBlockId);
+        sMenuInputBlocked = false;
+        // Nav back on (only if the setting says so): the touchpad opens
+        // the menu through Gui::DrawMenu, which needs the BACK key mapped.
+        if (CVarGetInteger(CVAR_IMGUI_CONTROLLER_NAV, 0) != 0) {
+            ImGui::GetIO().ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+        }
+    }
+    sMenuWasOpen = menuOpen;
+    if (!menuOpen) {
+        sZoomHoldFrames = 0;
+        sZoomDir = 0;
+        sScrollHoldFrames = 0;
+        sScrollDir = 0;
+        return;
+    }
+
+    // --- gamepad nav OFF while the menu is open: the D-pad and the
+    // sticks are ours now, not ImGui's focus movement. (See the header
+    // comment: this runs after DrawMenu in the frame, so the clear wins
+    // over UpdateGamepadNavigation for the next frame's NewFrame.) ---
+    ImGui::GetIO().ConfigFlags &= ~ImGuiConfigFlags_NavEnableGamepad;
+
+    // --- wider scrollbar while the menu is open ---
+    // Set every frame: ScaleImGui()'s ScaleAllSizes rescales it on zoom
+    // change, and this keeps it at 28 px * the current font scale.
+    ImGui::GetStyle().ScrollbarSize = 28.0f * ImGui::GetIO().FontGlobalScale;
+
+    // --- BACK closes the menu (takeover) ---
+    // With nav off, the backend never sets ImGuiKey_GamepadBack, so
+    // Gui::DrawMenu cannot close the menu on the touchpad anymore; the
+    // close is read straight from the SDL controller here instead.
+    // Rising edge only: one close per press, not one per frame held.
+    const bool backDown = PadButton(SDL_CONTROLLER_BUTTON_BACK);
+    if (backDown && !sBackPrev) {
+        auto gui = Ship::Context::GetRawInstance()->GetWindow()->GetGui();
+        if (gui != nullptr) {
+            auto menu = gui->GetMenu();
+            if (menu != nullptr) {
+                menu->ToggleVisibility();
+            }
+        }
+        sBackPrev = true;
+        // The menu just closed: release the game-input block and restore
+        // nav now instead of waiting a frame (same as the transition
+        // branch above).
+        if (sMenuInputBlocked) {
+            ControllerUnblockGameInput(kMenuInputBlockId);
+            sMenuInputBlocked = false;
+        }
+        if (CVarGetInteger(CVAR_IMGUI_CONTROLLER_NAV, 0) != 0) {
+            ImGui::GetIO().ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+        }
+        sMenuWasOpen = false;
+        sZoomHoldFrames = 0;
+        sZoomDir = 0;
+        sScrollHoldFrames = 0;
+        sScrollDir = 0;
+        return;
+    }
+    sBackPrev = backDown;
+
+    // --- zoom: D-pad left/right steps the existing ImGuiScale setting ---
+    const int zoomDir = (PadButton(SDL_CONTROLLER_BUTTON_DPAD_RIGHT) ? 1 : 0) -
+                        (PadButton(SDL_CONTROLLER_BUTTON_DPAD_LEFT) ? 1 : 0);
+    if (RepeatStep(zoomDir, sZoomHoldFrames, sZoomDir)) {
+        const int current = CVarGetInteger(CVAR_SETTING("ImGuiScale"), 1);
+        int next = current + zoomDir;
+        if (next < 0) {
+            next = 0;
+        }
+        if (next > 3) {
+            next = 3;
+        }
+        if (next != current) {
+            CVarSetInteger(CVAR_SETTING("ImGuiScale"), next);
+            OTRGlobals::Instance->ScaleImGui();
+        }
+    }
+
+    // --- scroll: D-pad up/down (step + repeat) and left stick (analog) ---
+    // Applied DIRECTLY to the "Main Menu" window (the outer scroller; the
+    // section content lives in tall children inside it), instead of
+    // injecting into io.MouseWheel — the wheel only scrolls the window
+    // under the pointer, and the pointer auto-hides and is almost never
+    // over the list. Up scrolls up (Scroll.y decreases).
+    float scrollDelta = 0.0f;
+    const float fontScale = ImGui::GetIO().FontGlobalScale;
+    const int scrollDir = (PadButton(SDL_CONTROLLER_BUTTON_DPAD_UP) ? 1 : 0) -
+                          (PadButton(SDL_CONTROLLER_BUTTON_DPAD_DOWN) ? 1 : 0);
+    if (RepeatStep(scrollDir, sScrollHoldFrames, sScrollDir)) {
+        scrollDelta -= static_cast<float>(scrollDir) * kScrollStepPx * fontScale;
+    }
+    // Left stick Y: up is negative on the axis. Deadzone ~8000/32768.
+    const int16_t stickY = PadAxis(SDL_CONTROLLER_AXIS_LEFTY);
+    if (stickY < -8000 || stickY > 8000) {
+        const float deflection = static_cast<float>(-stickY) / 32768.0f;
+        scrollDelta -= deflection * kScrollStickPxPerFrame * fontScale;
+    }
+    if (scrollDelta != 0.0f) {
+        ImGuiWindow* menuWindow = ImGui::FindWindowByName("Main Menu");
+        if (menuWindow != nullptr) {
+            ImGui::SetScrollY(menuWindow, menuWindow->Scroll.y + scrollDelta);
+        }
+    }
+}
+
+static void Tick() {
+    // Test-toast combo and menu input poll every frame (the unlock check
+    // below is throttled).
+    CheckTestCombo();
+    CheckMenuInput();
+    // Throttle: check every 30 frames (~0.5 s at 60 fps). Achievements are
+    // meta-progression; a half-second delay is unnoticeable.
+    static int frameCounter = 0;
+    if ((++frameCounter % 30) != 0) {
+        return;
+    }
+
+    const int unlockedBefore = UnlockedCount();
+    std::vector<const Def*> newlyUnlocked;
+    auto unlock = [&newlyUnlocked](const Def* def) {
+        CVarSetInteger(UnlockedCVar(def->id).c_str(), 1);
+        newlyUnlocked.push_back(def);
+        SPDLOG_INFO("[Achievements] Unlocked {} ({} pts)", def->titleEn, def->points);
+    };
+
+    // #31 Home Sweet Home (win condition) is checked BEFORE the
+    // save-loaded gate: there is no persistent "game beaten" flag in the
+    // save; the only signal is the live gameMode END_CREDITS during the
+    // ending (z_demo.c sets it in the two ending cutscene terminators and
+    // nowhere else). IsSaveLoaded() is false during the credits (it
+    // requires GAMEMODE_NORMAL), so the gated loop below would never see
+    // it. The unlock latches to its CVar + SaveNow, so it persists. The
+    // gameMode check needs no extra guard: END_CREDITS is only reachable
+    // by beating Ganon, and the demo system resets it to NORMAL when the
+    // credits end.
+    const Def* winDef = FindDef(31);
+    if (winDef != nullptr && winDef->implemented && !IsUnlocked(31) &&
+        gSaveContext.gameMode == GAMEMODE_END_CREDITS) {
+        unlock(winDef);
+    }
+
+    // Randomizer win achievements (1002, 1008, 1010, 1020): same
+    // END_CREDITS signal as #31, gated on a seed being loaded. The
+    // timestamps inside CheckRandoWin() tell a Ganon win apart from a
+    // Triforce Hunt win.
+    if (IS_RANDO && gSaveContext.gameMode == GAMEMODE_END_CREDITS) {
+        for (int id : { 1002, 1008, 1010, 1020 }) {
+            const Def* def = FindDef(id);
+            if (def != nullptr && def->implemented && !IsUnlocked(id) && CheckRandoWin(id)) {
+                unlock(def);
+            }
+        }
+    }
+
+    // Everything else: only while a save is loaded (title screen / file
+    // select have no save).
+    if (GameInteractor::IsSaveLoaded()) {
+        for (const Def& def : kDefs) {
+            if (!def.implemented || IsEndCreditsWin(def.id) || IsUnlocked(def.id)) {
+                continue;
+            }
+            if (CheckCondition(def.id)) {
+                unlock(&def);
+            }
+        }
+    }
+    if (newlyUnlocked.empty()) {
+        return;
+    }
+    CVarSetInteger(kHasUnseen, 1);
+    SaveNow();
+    EmitUnlockToast(newlyUnlocked, unlockedBefore == 0);
+}
+
+// ---------------------------------------------------------------------------
+// Init
+// ---------------------------------------------------------------------------
+void Init() {
+    // A toast can outlive the session (game closed while it was up), leaving
+    // a stale 1 in the config; no toast is visible at boot.
+    CVarSetInteger(kToastVisible, 0);
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnGameFrameUpdate>(Tick);
+}
+
+static RegisterShipInitFunc initFunc(Init);
+
+} // namespace Achievements
