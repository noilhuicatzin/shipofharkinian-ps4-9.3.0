+// ---------------------------------------------------------------------------
+// Detection (phase 2, run #20: the 32 DIRECTO + 23 of the 25 DIRECTO*)
+// Every condition verified against the real 9.3.0 source (see
+// randomizer/RA-MAIN-SET.md). #35 (bribe the guard) and #38 (cow milk)
+// are NOT implemented: no persistent flag exists for either (verified by
+// reading the actors); they need runtime hooks, a later phase.
+// #31 (win condition) is handled separately in Tick(): there is no
+// persistent "game beaten" flag; the only signal is the live gameMode
+// END_CREDITS during the ending.
+// ---------------------------------------------------------------------------
+static int CountBottles() {
+    // Bottles held, excluding the un-delivered Ruto's Letter (which sits
+    // in a bottle slot but is not a bottle). Mirrors Logic::BottleCount.
+    int count = 0;
+    const u8* items = gSaveContext.inventory.items;
+    const u8 bottleSlots[] = { SLOT_BOTTLE_1, SLOT_BOTTLE_2, SLOT_BOTTLE_3, SLOT_BOTTLE_4 };
+    for (u8 slot : bottleSlots) {
+        if (items[slot] != ITEM_NONE && items[slot] != ITEM_LETTER_RUTO) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+static bool CheckCartographer() {
+    // Map + compass in all 10 dungeons that have them; boss key only where
+    // one exists (the 5 temples + Ganon's Tower). Deku Tree, Dodongo's
+    // Cavern, Jabu-Jabu's Belly, Bottom of the Well and Ice Cavern have no
+    // boss key, so requiring it there would be impossible.
+    static const int kMapCompassScenes[] = {
+        SCENE_DEKU_TREE, SCENE_DODONGOS_CAVERN, SCENE_JABU_JABU, SCENE_FOREST_TEMPLE,
+        SCENE_FIRE_TEMPLE, SCENE_WATER_TEMPLE, SCENE_SPIRIT_TEMPLE, SCENE_SHADOW_TEMPLE,
+        SCENE_BOTTOM_OF_THE_WELL, SCENE_ICE_CAVERN,
+    };
+    for (int scene : kMapCompassScenes) {
+        if (!CHECK_DUNGEON_ITEM(DUNGEON_MAP, scene) ||
+            !CHECK_DUNGEON_ITEM(DUNGEON_COMPASS, scene)) {
+            return false;
+        }
+    }
+    static const int kBossKeyScenes[] = {
+        SCENE_FOREST_TEMPLE, SCENE_FIRE_TEMPLE, SCENE_WATER_TEMPLE, SCENE_SPIRIT_TEMPLE,
+        SCENE_SHADOW_TEMPLE, SCENE_GANONS_TOWER,
+    };
+    for (int scene : kBossKeyScenes) {
+        if (!CHECK_DUNGEON_ITEM(DUNGEON_KEY_BOSS, scene)) {
+            return false;
+        }
+    }
+    return true;
+}
