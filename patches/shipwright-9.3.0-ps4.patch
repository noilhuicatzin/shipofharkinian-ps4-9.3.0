+static bool CheckRandomizer(int id) {
+    // Every Randomizer achievement needs a seed loaded.
+    if (!IS_RANDO) {
+        return false;
+    }
+    switch (id) {
+        case 1003: // Would You Kindly — seed generated with Entrance Shuffle.
+            // FinalizeSettings resolves it to RO_GENERIC_ON when any
+            // entrance shuffle is on, else OFF (settings.cpp).
+            return RandoContextReady() && RandoSetting(RSK_SHUFFLE_ENTRANCES) != 0;
+        case 1004: // Token Shuffle — seed generated with Token Shuffle.
+            return RandoContextReady() && RandoSetting(RSK_SHUFFLE_TOKENS) != RO_TOKENSANITY_OFF;
+        case 1006: // Kokiri Sword Shuffle.
+            return RandoContextReady() && RandoSetting(RSK_SHUFFLE_KOKIRI_SWORD) != 0;
+        case 1014: // 100 Skulltulas in a seed.
+            return gSaveContext.inventory.gsTokens >= 100;
+        case 1015: // 20 hearts in a seed.
+            return gSaveContext.healthCapacity == 0x140;
+        case 1016: // All 12 songs in a seed.
+            return CheckAllSongs();
+        case 1017: // All equipment in a seed.
+            return CheckAllEquipment();
+        case 1018: // All 6 medallions + 3 Spiritual Stones in a seed.
+            return CheckAllDungeonRewards();
+        case 1019: // All masks in a seed.
+            return CheckAllMasks();
+        default:
+            return false;
+    }
+}
+
+// Win achievements (1002, 1008, 1010, 1020): checked in Tick() before
+// the save-loaded gate, like #31. Caller guarantees END_CREDITS and
+// IS_RANDO. The timestamps are the discriminator (see the section
+// comment above): a Triforce Hunt win sets TIMESTAMP_TRIFORCE_COMPLETED
+// and NOT TIMESTAMP_DEFEAT_GANON, so it unlocks only 1010.
+static bool CheckRandoWin(int id) {
+    switch (id) {
+        case 1002: // Seed Beater — beat Ganon in a seed.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] != 0;
+        case 1008: { // Increased Damage — beat Ganon with damage x2 or more.
+            if (gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] == 0 ||
+                !RandoContextReady()) {
+                return false;
+            }
+            // Explicit comparisons, not >= : the damage enum order is
+            // verified (HALF, DEFAULT, DOUBLE, QUADRUPLE, OCTUPLE,
+            // SEXDECUPLE, OHKO) but >= on the enum relies on it staying
+            // sequential, so spell out every value >= DOUBLE.
+            const u8 damage = RandoSetting(RSK_DAMAGE_MULTIPLIER);
+            return damage == RO_DAMAGE_MULTIPLIER_DOUBLE ||
+                   damage == RO_DAMAGE_MULTIPLIER_QUADRUPLE ||
+                   damage == RO_DAMAGE_MULTIPLIER_OCTUPLE ||
+                   damage == RO_DAMAGE_MULTIPLIER_SEXDECUPLE || damage == RO_DAMAGE_MULTIPLIER_OHKO;
+        }
+        case 1010: // Wisdom, Power and Courage — Triforce Hunt win.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_TRIFORCE_COMPLETED] != 0;
+        case 1020: // Heartless — beat Ganon with 3 hearts, no containers.
+            // healthCapacity 0x30 = 3 hearts: no containers (each +0x10)
+            // and no heart pieces (4 pieces = +0x10) can have been taken.
+            return gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON] != 0 &&
+                   gSaveContext.healthCapacity == 0x30;
+        default:
+            return false;
+    }
+}
