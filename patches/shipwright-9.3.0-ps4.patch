+// ---------------------------------------------------------------------------
+// Run #29 live trackers (called from Tick's unthrottled part, every frame)
+// ---------------------------------------------------------------------------
+// Dungeon index of a scene, for the dungeonKeys[] array and the reward
+// home-dungeon checks (1007/1013). Mirrors the mapIndex rule in
+// z_map_exp.c: a main dungeon scene's index IS its scene number
+// (0x00-0x10), a boss room's index is scene - SCENE_DEKU_TREE_BOSS
+// (0x11-0x18 -> 0-7). Anything else (overworld, Chamber of Sages,
+// Temple of Time, ...) is not a dungeon: -1.
+static int DungeonIndexOfScene(int scene) {
+    if (scene >= SCENE_DEKU_TREE && scene <= SCENE_TREASURE_BOX_SHOP) {
+        return scene;
+    }
+    if (scene >= SCENE_DEKU_TREE_BOSS && scene <= SCENE_SHADOW_TEMPLE_BOSS) {
+        return scene - SCENE_DEKU_TREE_BOSS;
+    }
+    return -1;
+}
+
+// Home dungeon (dungeonKeys index) of each dungeon reward, for #1013.
+// The Light Medallion has no dungeon home (it is Rauru's, in the Chamber
+// of Sages with no boss before it): home -2, so any boss-sourced Light
+// Medallion is out of its home.
+struct RewardHome {
+    int questBit;
+    int homeDungeon; // dungeonKeys index, or -2 for the Light Medallion
+};
+static const RewardHome kRewardHomes[] = {
+    { QUEST_MEDALLION_FOREST, SCENE_FOREST_TEMPLE },
+    { QUEST_MEDALLION_FIRE, SCENE_FIRE_TEMPLE },
+    { QUEST_MEDALLION_WATER, SCENE_WATER_TEMPLE },
+    { QUEST_MEDALLION_SPIRIT, SCENE_SPIRIT_TEMPLE },
+    { QUEST_MEDALLION_SHADOW, SCENE_SHADOW_TEMPLE },
+    { QUEST_MEDALLION_LIGHT, -2 },
+    { QUEST_KOKIRI_EMERALD, SCENE_DEKU_TREE },
+    { QUEST_GORON_RUBY, SCENE_DODONGOS_CAVERN },
+    { QUEST_ZORA_SAPPHIRE, SCENE_JABU_JABU },
+};
+
+// #1007 (key outside its dungeon) + #1013 (reward outside its dungeon).
+// Both are about WHERE an item was obtained, so they are polled every
+// frame (not in the 1.5 s throttled loop — the player could warp out
+// before the next throttle tick and the source scene would be lost).
+// The snapshots re-initialize whenever no save is loaded (title screen /
+// file select), so loading a different save never false-triggers on the
+// keys/rewards it already has.
+static void UpdateRandoPickupTracker() {
+    if (!IS_RANDO) {
+        return;
+    }
+    static bool sReady = false;
+    static s8 sPrevKeys[19] = {};
+    static u32 sPrevRewards = 0;
+    PlayState* play = gPlayState;
+    if (play == nullptr || !GameInteractor::IsSaveLoaded()) {
+        // No save loaded (title screen / file select): forget the
+        // snapshots, so the next save re-initializes them instead of
+        // comparing against a different save's keys/rewards.
+        sReady = false;
+        return;
+    }
+    if (!sReady) {
+        for (int i = 0; i < 19; ++i) {
+            sPrevKeys[i] = gSaveContext.inventory.dungeonKeys[i];
+        }
+        sPrevRewards = 0;
+        for (const RewardHome& rh : kRewardHomes) {
+            if (CHECK_QUEST_ITEM(rh.questBit)) {
+                sPrevRewards |= (1u << rh.questBit);
+            }
+        }
+        // A new save was loaded: forget the last boss defeated in the
+        // previous save, or a reward earned in this save (e.g. the
+        // vanilla Light Medallion, which has no boss before it) could
+        // false-trigger #1013 from the old save's boss. The boss defeat
+        // and its medallion always happen in one session (the blue warp
+        // is immediate, no save in between), so nothing real is lost.
+        sLastBossDefeatScene = -1;
+        sReady = true;
+        return;
+    }
+    // Source dungeon of an item obtained right now: the dungeon of the
+    // current scene when it is one (a key from a chest, a stone in its
+    // boss room), else the last boss defeated when the current scene is
+    // the Chamber of Sages (medallions are awarded there, after the blue
+    // warp). Any other non-dungeon scene -> unknown (-1), do not unlock.
+    auto sourceDungeon = [&]() -> int {
+        int fromScene = DungeonIndexOfScene(play->sceneNum);
+        if (fromScene >= 0) {
+            return fromScene;
+        }
+        if (play->sceneNum == SCENE_CHAMBER_OF_THE_SAGES && sLastBossDefeatScene >= 0) {
+            return DungeonIndexOfScene(sLastBossDefeatScene);
+        }
+        return -1;
+    };
+    // #1007: a small key count went up. Its home is its own index; the
+    // source is where the player is. (In vanilla a key is always found
+    // in its own dungeon, so this can only fire with a key shuffle.)
+    for (int i = 0; i < 19; ++i) {
+        const s8 keys = gSaveContext.inventory.dungeonKeys[i];
+        if (keys > sPrevKeys[i]) {
+            const int source = sourceDungeon();
+            if (source >= 0 && source != i) {
+                sHookFired[1007] = true;
+            }
+        }
+        sPrevKeys[i] = keys;
+    }
+    // #1013: a dungeon reward bit went up. Its home is the table above;
+    // the source is the same rule. (In vanilla a reward is always earned
+    // in its own dungeon, so this can only fire with a reward shuffle.)
+    for (const RewardHome& rh : kRewardHomes) {
+        const bool has = CHECK_QUEST_ITEM(rh.questBit) != 0;
+        const bool had = (sPrevRewards & (1u << rh.questBit)) != 0;
+        if (has && !had) {
+            if (rh.homeDungeon == -2) {
+                // Light Medallion: any boss-sourced one is out of home
+                // (vanilla has no boss before it).
+                if (sLastBossDefeatScene >= 0) {
+                    sHookFired[1013] = true;
+                }
+            } else {
+                const int source = sourceDungeon();
+                if (source >= 0 && source != rh.homeDungeon) {
+                    sHookFired[1013] = true;
+                }
+            }
+        }
+        if (has) {
+            sPrevRewards |= (1u << rh.questBit);
+        } else {
+            sPrevRewards &= ~(1u << rh.questBit);
+        }
+    }
+}
+
+// #1021 (Flawless Boss Rush): latch "damage taken during this rush".
+// Polled every frame while a Boss Rush is in progress (finish timestamp
+// still 0); a health decrease latches the CVar, which persists across
+// save/load of the same rush file and is reset only by a new Boss Rush
+// (Achievements_NotifyBossRushStart, BossRush_InitSave). Between-boss
+// damage (Chamber of Sages) has no enemies, so in practice this is the
+// boss fights — but polling the player directly covers every source.
+static void UpdateBossRushDamage() {
+    static int sLastHealth = -1;
+    if (!IS_BOSS_RUSH ||
+        gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_BOSSRUSH_FINISH] != 0) {
+        // Not in an active rush (title screen, another mode, or the rush
+        // is already finished): forget the last health, so the next rush
+        // initializes from its own starting health. A stale value from
+        // a previous attempt could be HIGHER than the new attempt's
+        // starting health and false-trigger the damage latch.
+        sLastHealth = -1;
+        return;
+    }
+    if (!GameInteractor::IsSaveLoaded()) {
+        sLastHealth = -1;
+        return;
+    }
+    const int health = gSaveContext.health;
+    if (sLastHealth < 0) {
+        sLastHealth = health;
+        return;
+    }
+    if (health < sLastHealth) {
+        CVarSetInteger(kBossRushTookDamage, 1);
+        SaveNow();
+    }
+    sLastHealth = health;
+}
+
+// #1022 (Five Seeds): count this Randomizer Ganon win once. Called from
+// Tick's END_CREDITS block; the defeat timestamp is the key, so the
+// 1.5 s re-runs during the credits cannot count one win twice.
+static void CountRandoWin() {
+    const u32 stamp = gSaveContext.ship.stats.itemTimestamp[TIMESTAMP_DEFEAT_GANON];
+    if (stamp == 0) {
+        return;
+    }
+    if (CVarGetInteger(kLastSeedWin, 0) == (int)stamp) {
+        return;
+    }
+    CVarSetInteger(kLastSeedWin, (int)stamp);
+    CVarSetInteger(kSeedsCompleted, CVarGetInteger(kSeedsCompleted, 0) + 1);
+    SaveNow();
+}
