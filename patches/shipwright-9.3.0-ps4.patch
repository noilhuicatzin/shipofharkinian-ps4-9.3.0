+static void DrawRewardsHeader(WidgetInfo&) {
+    const int count = Achievements::UnlockedCount();
+    const int total = static_cast<int>(Achievements::GetDefs().size()); // 113
+    const int points = Achievements::UnlockedPoints();
+    const int maxPoints = 1000; // implementable points (#46's 5 cannot unlock)
+    const int pieces = Achievements::TriforcePieces();
+    const Achievements::RankInfo rank = Achievements::CurrentRank();
+    const char* title = Achievements::TitleForCount(count);
+    int needed = 0;
+    const char* nextTitle = Achievements::NextTitleForCount(count, &needed);
+
+    DrawLanguageButtons();
+
+    // Title + unseen dot.
+    ImGui::TextColored(kPalGold, "%s", Achievements::Tr("ACHIEVEMENTS", "LOGROS").c_str());
+    if (Achievements::HasUnseen()) {
+        const ImVec2 rmin = ImGui::GetItemRectMin();
+        const ImVec2 rmax = ImGui::GetItemRectMax();
+        ImGui::GetWindowDrawList()->AddCircleFilled(
+            ImVec2(rmax.x + 12, (rmin.y + rmax.y) * 0.5f), 5.0f, ImGui::GetColorU32(kPalGold));
+    }
+    ImGui::TextColored(kPalMuted, "%s",
+                       Achievements::Tr(spdlog::fmt_lib::format("{} achievements in total · Vanilla + Randomizer",
+                                                                total),
+                                        spdlog::fmt_lib::format("{} logros en total · Vainilla + Randomizer", total))
+                           .c_str());
+
+    // Filling Triforce (ImDrawList triangles; gated by the Triforce switch).
+    if (Achievements::RewardEnabled("Triforce")) {
+        ImDrawList* dl = ImGui::GetWindowDrawList();
+        const ImVec2 origin = ImGui::GetCursorScreenPos();
+        const float side = 22.0f;
+        DrawTriforce(dl, origin, side, pieces);
+        ImGui::Dummy(ImVec2(side * 2.0f, side * 2.0f * 0.866f));
