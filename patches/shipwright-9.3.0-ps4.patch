+    for (int i = 0; i < 8; i++) {
+        const RewardCard& card = kRewardCards[i];
+        const bool on = Achievements::RewardEnabled(card.suffix);
+        if (i > 0 && i % cols != 0) {
+            ImGui::SameLine(0, spacingX);
