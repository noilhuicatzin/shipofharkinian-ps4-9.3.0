+static void DrawLanguageButtons() {
+    const int lang = Achievements::Language();
+    ImGui::TextColored(kPalMuted, "%s", Achievements::Tr("MENU LANGUAGE", "IDIOMA DEL MENÚ").c_str());
+    ImGui::SameLine();
+    const float btnW = 64.0f;
+    const float gap = ImGui::GetStyle().ItemSpacing.x;
+    const float totalW = btnW * 2 + gap;
+    ImGui::SetCursorPosX(ImGui::GetWindowContentRegionMax().x - totalW);
+    const struct {
+        const char* label;
+        int value;
+    } buttons[] = { { "EN", 0 }, { "ES", 1 } };
+    for (int i = 0; i < 2; i++) {
+        if (i > 0) {
+            ImGui::SameLine(0, gap);
