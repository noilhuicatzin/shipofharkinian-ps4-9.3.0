+// ---------------------------------------------------------------------------
+// CVar names
+// ---------------------------------------------------------------------------
+// Unlocks / meta-progression persist in the game config
+// (Ship_of_Harkinian.json) via the CVar system, so they survive across
+// saves and seeds. One CVar per achievement id keeps the state simple and
+// debuggable from the console.
+static const char* kUnlockedPrefix = "gAchievements.Unlocked.";
+static const char* kRevealedPrefix = "gAchievements.Revealed.";
+static const char* kHasUnseen = "gAchievements.HasUnseen";
+static const char* kLanguage = "gAchievements.Language"; // 0 = English, 1 = Español
+
+static std::string UnlockedCVar(int id) {
+    return std::string(kUnlockedPrefix) + std::to_string(id);
+}
+static std::string RevealedCVar(int id) {
+    return std::string(kRevealedPrefix) + std::to_string(id);
+}
+
+static void SaveNow() {
+    Ship::Context::GetRawInstance()->GetWindow()->GetGui()->SaveConsoleVariablesNextFrame();
+}
