+           CHECK_QUEST_ITEM(QUEST_SONG_LULLABY) && CHECK_QUEST_ITEM(QUEST_SONG_EPONA) &&
+           CHECK_QUEST_ITEM(QUEST_SONG_SARIA) && CHECK_QUEST_ITEM(QUEST_SONG_SUN) &&
+           CHECK_QUEST_ITEM(QUEST_SONG_TIME) && CHECK_QUEST_ITEM(QUEST_SONG_STORMS);
+}
