+// ---------------------------------------------------------------------------
+// Slot divisions: 40 pts each, 25 divisions. Rank = 3 divisions:
+// Iron 1-3, Bronze 4-6, Silver 7-9, Gold 10-12, Platinum 13-15,
+// Diamond 16-18, Ascendant 19-21, Immortal 22-24, Radiant 25 (1000 pts).
+// Colours are the mockup hex values.
+struct RankDef {
+    const char* name;
+    float r, g, b;
+};
+static const RankDef kRankDefs[] = {
+    { "Iron", 0x6b / 255.0f, 0x6f / 255.0f, 0x6a / 255.0f },
+    { "Bronze", 0xa0 / 255.0f, 0x6a / 255.0f, 0x2c / 255.0f },
+    { "Silver", 0xb9 / 255.0f, 0xc0 / 255.0f, 0xc7 / 255.0f },
+    { "Gold", 0xd9 / 255.0f, 0xae / 255.0f, 0x3f / 255.0f },
+    { "Platinum", 0x2a / 255.0f, 0xa7 / 255.0f, 0x9b / 255.0f },
+    { "Diamond", 0x7e / 255.0f, 0x8c / 255.0f, 0xe6 / 255.0f },
+    { "Ascendant", 0x2e / 255.0f, 0xa8 / 255.0f, 0x6a / 255.0f },
+    { "Immortal", 0xc9 / 255.0f, 0x3a / 255.0f, 0x5e / 255.0f },
+    { "Radiant", 0xe6 / 255.0f, 0xc6 / 255.0f, 0x19 / 255.0f },
+};
+
+RankInfo RankForPoints(int points) {
+    if (points < 0) {
+        points = 0;
+    }
+    int division = points / 40 + 1;
+    if (division > 25) {
+        division = 25;
+    }
+    const RankDef& def = kRankDefs[(division - 1) / 3];
+    const int pointsToNext = (division >= 25) ? -1 : division * 40 - points;
+    return RankInfo{ def.name, ImVec4(def.r, def.g, def.b, 1.0f), division, pointsToNext };
+}
+
+RankInfo CurrentRank() {
+    return RankForPoints(UnlockedPoints());
