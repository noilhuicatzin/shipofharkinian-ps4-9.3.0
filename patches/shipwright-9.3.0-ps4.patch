+static bool CheckCondition(int id) {
+    // Runtime hook events (boss-defeat verdicts, actor hooks): latched by
+    // the hook and consumed here, so the unlock + toast go through the
+    // normal Tick() path. Tick() clears the latch when it unlocks.
+    if (id > 0 && id < 1024 && sHookFired[id]) {
+        return true;
+    }
+    if (IsProgression(id)) {
+        return CheckProgression(id);
+    }
+    const Def* def = FindDef(id);
+    if (def != nullptr && def->category == Category::Randomizer) {
+        return CheckRandomizer(id);
+    }
+    return CheckDirecto(id);
+}
