+static void RegisterFightHooks() {
+    // Arm the tracker when a boss spawns (once per spawn, including
+    // re-entry after a death).
+    // NOTE (run #29, corrected): ACTOR_BOSS_FD is NOT "the painting
+    // phantoms" — it is Volvagia's BODY (health 24, spawns the head
+    // ACTOR_BOSS_FD2 as a child). It is still deliberately NOT armed:
+    // arming it would re-arm (reset) the tracker when the head spawns.
+    // The real Phantom Ganon is ACTOR_BOSS_GANONDROF, armed below — but
+    // only in the Forest Temple boss scene, because the same actor id is
+    // also the organ-playing Ganondorf in Ganon's Castle (a different
+    // scene). The scene gate lives in UpdateFightTracker (IsBossScene
+    // disarms outside a boss scene), and the Ganondrof arm below is
+    // further guarded by checking the scene at arm time.
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_GOMA, true, [](void*) { ArmFight(ACTOR_BOSS_GOMA); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_DODONGO, true, [](void*) { ArmFight(ACTOR_BOSS_DODONGO); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_VA, true, [](void*) { ArmFight(ACTOR_BOSS_VA); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_FD2, true, [](void*) { ArmFight(ACTOR_BOSS_FD2); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_MO, true, [](void*) { ArmFight(ACTOR_BOSS_MO); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_SST, true, [](void*) { ArmFight(ACTOR_BOSS_SST); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_TW, true, [](void*) { ArmFight(ACTOR_BOSS_TW); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_GANON, true, [](void*) { ArmFight(ACTOR_BOSS_GANON); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_GANON2, true, [](void*) { ArmFight(ACTOR_BOSS_GANON2); });
+    COND_ID_HOOK(OnActorInit, ACTOR_BOSS_GANONDROF, true, [](void*) {
+        // Phantom Ganon only: the same actor id is Ganondorf at the organ
+        // in Ganon's Castle, so arm only in the Forest Temple boss scene.
+        if (gPlayState != nullptr && gPlayState->sceneNum == SCENE_FOREST_TEMPLE_BOSS) {
+            ArmFight(ACTOR_BOSS_GANONDROF);
+        }
+    });
+    // Evaluate the fight when the boss dies (killing blow, same frame).
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_GOMA, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_GOMA); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_DODONGO, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_DODONGO); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_VA, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_VA); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_FD2, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_FD2); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_MO, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_MO); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_SST, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_SST); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_TW, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_TW); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_GANON, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_GANON); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_GANON2, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_GANON2); });
+    COND_ID_HOOK(OnBossDefeat, ACTOR_BOSS_GANONDROF, true, [](void*) { EvaluateBossDefeat(ACTOR_BOSS_GANONDROF); });
+    // #6 Bombalicious (run #29): King Dodongo's fire breath spawns an
+    // ACTOR_EN_BDFIRE, and only ever from z_boss_dodongo.c — so its first
+    // init IS the first breath. (The arm guard keeps a stray spawn from
+    // latching outside the Dodongo fight.)
+    COND_ID_HOOK(OnActorInit, ACTOR_EN_BDFIRE, true, [](void*) {
+        if (sFight.armed && sFight.bossActorId == ACTOR_BOSS_DODONGO) {
+            sFight.dodongoBreathedFire = true;
+        }
+    });
+    // #44 Cuccos' Revenge: an attack cucco (ACTOR_EN_ATTACK_NIW) only ever
+    // spawns as the start of a swarm (z_en_niw.c), so its first init IS the
+    // swarm. Fires before the first peck; the design says "detect the
+    // swarm", so that is the intended signal.
+    COND_ID_HOOK(OnActorInit, ACTOR_EN_ATTACK_NIW, true, [](void*) { sHookFired[44] = true; });
+}
