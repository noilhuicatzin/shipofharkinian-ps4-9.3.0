+                                            spdlog::fmt_lib::format("TRIFORCE COMPLETO · {}/3", pieces))
+                               .c_str());
+    }
+
+    // Progress (count) + points.
+    const int pct = total > 0 ? (count * 100 / total) : 0;
+    ImGui::TextColored(kPalCream, "%s",
+                       spdlog::fmt_lib::format("{}/{} · {}%", count, total, pct).c_str());
+    ImGui::PushStyleColor(ImGuiCol_PlotHistogram, kPalGold);
+    ImGui::PushStyleColor(ImGuiCol_FrameBg, kPalLine);
+    ImGui::ProgressBar(total > 0 ? static_cast<float>(count) / total : 0.0f, ImVec2(-1, 14), "");
+    ImGui::PopStyleColor(2);
+    ImGui::TextColored(kPalCream, "%s",
+                       spdlog::fmt_lib::format("{}/{} pts", points, maxPoints).c_str());
+    ImGui::SameLine();
+    if (points >= maxPoints) {
+        ImGui::TextColored(kPalGreen, "%s", Achievements::Tr("Maximum reached!", "¡Máximo alcanzado!").c_str());
+    } else {
+        ImGui::TextColored(kPalMuted, "%s",
+                           Achievements::Tr(spdlog::fmt_lib::format("{} pts to the maximum", maxPoints - points),
+                                            spdlog::fmt_lib::format("Faltan {} pts para el máximo", maxPoints - points))
+                               .c_str());
+    }
+
+    // Rank card.
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, kPalPanel);
+    ImGui::PushStyleColor(ImGuiCol_Border, kPalGold);
+    ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, 12.0f);
+    ImGui::BeginChild("##rankcard", ImVec2(0, 0), ImGuiChildFlags_Border | ImGuiChildFlags_AutoResizeY);
+    ImGui::TextColored(kPalMuted, "%s", Achievements::Tr("CURRENT RANK", "RANGO ACTUAL").c_str());
+    if (Achievements::RewardEnabled("Title")) {
+        ImGui::TextColored(rank.color, "%s", title);
+    } else {
+        ImGui::TextColored(kPalMuted, "%s", Achievements::Tr("(title reward off)", "(título apagado)").c_str());
+    }
+    if (nextTitle != nullptr) {
+        ImGui::TextColored(kPalMuted, "%s",
+                           Achievements::Tr(spdlog::fmt_lib::format("Next rank: {} — {} more achievements", nextTitle,
+                                                                    needed),
+                                            spdlog::fmt_lib::format("Siguiente rango: {} — faltan {} logros",
+                                                                    nextTitle, needed))
+                               .c_str());
+    } else {
+        ImGui::TextColored(kPalGreen, "%s",
+                           Achievements::Tr("Highest rank reached!", "¡Rango máximo alcanzado!").c_str());
+    }
+    ImGui::TextColored(kPalMuted, "%s",
+                       Achievements::Tr(spdlog::fmt_lib::format("Slot: {} · division {}/25", rank.name,
+                                                                rank.division),
+                                        spdlog::fmt_lib::format("Slot: {} · división {}/25", rank.name, rank.division))
+                           .c_str());
+    ImGui::EndChild();
+    ImGui::PopStyleVar();
+    ImGui::PopStyleColor(2);
+
+    // Slot pips: 25 divisions, one per 40 pts; Radiant gold at 1000 pts.
+    {
+        const float availW = ImGui::GetContentRegionAvail().x;
+        const int filled = std::min(25, points / 40);
+        const float gap = 3.0f;
+        float pipW = (availW - 24 * gap) / 25.0f;
+        if (pipW < 2.0f) {
+            pipW = 2.0f;
+        }
+        ImDrawList* dl = ImGui::GetWindowDrawList();
