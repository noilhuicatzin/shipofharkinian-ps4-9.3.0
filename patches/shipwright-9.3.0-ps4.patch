+                dl->AddText(ImVec2(b0.x + (boxW - textSize.x) * 0.5f, b0.y + (boxH - textSize.y) * 0.5f),
+                            ImGui::GetColorU32(kPillGoldFg), num.c_str());
+            } else {
+                dl->AddRectFilled(b0, b1, ImGui::GetColorU32(kPalCard), 6.0f);
+                if (isNext) {
+                    dl->AddRect(b0, b1, ImGui::GetColorU32(kPalGold), 6.0f, 0, 1.5f);
+                } else {
+                    dl->AddRect(b0, b1, ImGui::GetColorU32(kPalLine), 6.0f, 0, 1.0f);
+                }
+                dl->AddText(ImVec2(b0.x + (boxW - textSize.x) * 0.5f, b0.y + (boxH - textSize.y) * 0.5f),
+                            ImGui::GetColorU32(isNext ? kPalGold : kPalMuted), num.c_str());
+            }
+        }
+        ImGui::Dummy(ImVec2(availW, boxH));
+        if (nextMs != nullptr) {
+            ImGui::TextColored(kPalMuted, "%s",
+                               Achievements::Tr(spdlog::fmt_lib::format("Next: {} — {}{}", nextMs->at, nextMs->name,
+                                                                        nextMs->noteEn[0] != '\0'
+                                                                            ? std::string(" · ") + nextMs->noteEn
+                                                                            : std::string("")),
+                                                spdlog::fmt_lib::format("Siguiente: {} — {}{}", nextMs->at,
+                                                                        nextMs->name,
+                                                                        nextMs->noteEs[0] != '\0'
+                                                                            ? std::string(" · ") + nextMs->noteEs
+                                                                            : std::string("")))
+                                   .c_str());
+        } else {
+            ImGui::TextColored(kPalGreen, "%s",
+                               Achievements::Tr("All milestones reached!", "¡Todos los hitos conseguidos!").c_str());
+        }
+    }
+
+    // Secret message: letter block, only at 112 + SecretMessage on.
+    if (Achievements::IsComplete() && Achievements::RewardEnabled("SecretMessage")) {
+        ImGui::PushStyleColor(ImGuiCol_ChildBg, kPalPanel);
+        ImGui::PushStyleColor(ImGuiCol_Border, kPalGold);
+        ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, 12.0f);
+        ImGui::BeginChild("##secretletter", ImVec2(0, 0), ImGuiChildFlags_Border | ImGuiChildFlags_AutoResizeY);
+        ImGui::TextColored(kPalGold, "%s", Achievements::Tr("Secret message", "Mensaje secreto").c_str());
+        ImGui::TextWrapped("%s",
+                           Achievements::Tr("Thank you for playing. You found every secret, beat every challenge, "
+                                            "and carried this journey all the way to its golden end. Hyrule is at "
+                                            "peace because you never gave up — and neither did we, building this "
