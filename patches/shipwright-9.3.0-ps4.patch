+    // Milestone ladder (8 boxes in a row; achieved = gold, next = gold border).
+    {
+        const float availW = ImGui::GetContentRegionAvail().x;
+        const float gap = 4.0f;
+        const float boxW = (availW - 7 * gap) / 8.0f;
+        const float boxH = 34.0f;
+        ImDrawList* dl = ImGui::GetWindowDrawList();
+        const ImVec2 p0 = ImGui::GetCursorScreenPos();
+        const Milestone* nextMs = nullptr;
+        for (const Milestone& ms : kMilestones) {
+            if (count < ms.at && nextMs == nullptr) {
+                nextMs = &ms;
+            }
+        }
+        for (int i = 0; i < 8; i++) {
+            const Milestone& ms = kMilestones[i];
+            const float x = p0.x + i * (boxW + gap);
+            const ImVec2 b0(x, p0.y);
+            const ImVec2 b1(x + boxW, p0.y + boxH);
+            const bool achieved = count >= ms.at;
+            const bool isNext = (nextMs != nullptr && nextMs == &ms);
+            const std::string num = std::to_string(ms.at);
+            const ImVec2 textSize = ImGui::CalcTextSize(num.c_str());
+            if (achieved) {
