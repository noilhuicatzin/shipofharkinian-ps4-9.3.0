+// ---------------------------------------------------------------------------
+// L3+R3 combo (run #24, Lux): what it does is a setting, CVar
+// "gAchievements.L3R3Mode" (0 = test toast, 1 = quick restart;
+// default 1 = quick restart). The setting is a visible combobox in the
+// Logros menu while testing; when testing ends it is hidden and quick
+// restart stays the default. Mode 0 is the old test-toast behaviour:
+// a test toast identical to a real unlock toast so the touchpad
+// shortcut can be tested on demand, without unlocking anything.
+// ---------------------------------------------------------------------------
+// The combo is read straight from the SDL game controller (same pattern as
+// OTRGlobals.cpp). On PS4 there is exactly one: the virtual pad, whose
+// LEFTSTICK/RIGHTSTICK buttons PadUpdate feeds from the physical L3/R3.
+// L3/R3 are not bound to any N64 button (Mapper only lists them for
+// display), so the combo conflicts with nothing in-game. The engine already
+// opens this controller (ConnectedPhysicalDeviceManager), and SDL refcounts
+// opens, so this handle is only borrowed: it is never closed here, only
+// dropped and re-scanned if detached.
+static SDL_GameController* sTestPad = nullptr;
+static bool sComboWasDown = false;
+
+// (Re)scan for the first game controller. No close: the engine owns the
+// lifecycle; dropping a detached pointer is enough. Shared by the
+// L3+R3 test combo and the menu D-pad / stick handler below.
+static bool EnsurePad() {
+    if (sTestPad == nullptr || SDL_GameControllerGetAttached(sTestPad) == SDL_FALSE) {
+        sTestPad = nullptr;
+        for (int i = 0; i < SDL_NumJoysticks(); ++i) {
+            if (SDL_IsGameController(i)) {
+                sTestPad = SDL_GameControllerOpen(i);
+                break;
+            }
+        }
+    }
+    return sTestPad != nullptr;
+}
+
+static bool PadButton(SDL_GameControllerButton button) {
+    return EnsurePad() && SDL_GameControllerGetButton(sTestPad, button) != 0;
+}
+
+static int16_t PadAxis(SDL_GameControllerAxis axis) {
+    return EnsurePad() ? SDL_GameControllerGetAxis(sTestPad, axis) : 0;
+}
+
+static bool IsTestComboDown() {
+    return PadButton(SDL_CONTROLLER_BUTTON_LEFTSTICK) &&
+           PadButton(SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+}
+
+static bool IsMenuOpen() {
+    auto gui = Ship::Context::GetRawInstance()->GetWindow()->GetGui();
+    if (gui == nullptr) {
+        return false;
+    }
+    auto menu = gui->GetMenu();
+    return menu != nullptr && menu->IsVisible();
+}
+
+// Forward: defined with the menu-input helpers below (it needs the
+// sMenuInputBlocked statics declared there).
+static void CloseMenuNow();
+
+static void DoQuickRestart() {
+    // The in-game Reset button and Ctrl+R do exactly this: dispatch
+    // "reset" to the console window. The command (debugconsole.cpp
+    // ResetHandler) sets the next game state to TitleSetup_Init and
+    // stops the current one — a soft reset to the title screen. It is
+    // safe with no game state (returns an error, no crash). It acts on
+    // the game state, not on the menu overlay, so it works with the menu
+    // open and stuck — that is the point: the escape hatch when the
+    // touchpad will not dismiss the menu. The menu itself is closed
+    // first so the game lands on the title screen with a clean state.
+    CloseMenuNow();
+    auto gui = Ship::Context::GetRawInstance()->GetWindow()->GetGui();
+    if (gui == nullptr) {
+        return;
+    }
+    auto consoleWin = std::reinterpret_pointer_cast<Ship::ConsoleWindow>(gui->GetGuiWindow("Console"));
+    if (consoleWin == nullptr) {
+        return;
+    }
+    consoleWin->Dispatch("reset");
+    // TEMP DIAG: proves the quick restart fired on console.
+    SPDLOG_INFO("[PS4] [diag] L3+R3 quick restart (reset dispatched)");
+    spdlog::default_logger()->flush();
+}
+
+static void CheckL3R3Combo() {
+    // Rising edge only: one action per press, not one per frame while held.
+    const bool down = IsTestComboDown();
+    const bool pressed = down && !sComboWasDown;
+    sComboWasDown = down;
+    if (!pressed) {
+        return;
+    }
+    // Quick restart (default): works anywhere, menu open or not.
+    if (CVarGetInteger("gAchievements.L3R3Mode", 1) == 1) {
+        DoQuickRestart();
+        return;
+    }
+    // Test-toast mode: only in-game (a save loaded, menu closed) and
+    // only when no toast is already up (a real toast keeps its window).
+    if (!GameInteractor::IsSaveLoaded() || sVisibleToasts > 0) {
+        return;
+    }
+    if (IsMenuOpen()) {
+        return;
+    }
+    EmitTestToast();
+}
