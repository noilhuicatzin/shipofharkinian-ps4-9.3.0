+struct FightTracker {
+    bool armed = false;      // a boss actor spawned (fight may still be in intro)
+    bool baselined = false;  // baselines snapshotted (player out of cutscene)
+    int bossActorId = 0;
+    bool tookDamage = false; // health decreased at any point in the fight
+    bool healed = false;     // health increased at any point in the fight
+    bool fairyUsed = false;  // a fairy left its bottle
+    bool bombUsed = false;   // bomb or bombchu ammo decreased
+    bool grabbed = false;    // PLAYER_STATE2_GRABBED_BY_ENEMY seen (tentacle/hand)
+    bool inWater = false;    // PLAYER_STATE1_IN_WATER seen (Morpha room)
+    bool fell = false;       // player Y below the platform threshold
+    bool lensUsed = false;   // play->actorCtx.lensActive seen (Bongo Bongo)
+    // Run #29 (DIFÍCIL damage attribution + boss-phase latches):
+    bool gohmaRetreated = false; // Gohma started climbing the wall (#1)
+    bool dodongoBreathedFire = false; // a BdFire (fire breath) spawned (#6)
+    bool bagBombUsed = false; // ITEM_BOMB ammo decreased — bag bombs only,
+        // NOT bombchus (bombUsed above combines both and #30 uses it; #6
+        // forbids only "Bombs from your bag")
+    bool nonArrowHit = false; // a non-arrow hit landed on Phantom Ganon (#13)
+    bool nonHammerHit = false; // a non-hammer hit landed on Volvagia (#95)
+    bool nonMasterSwordHit = false; // a non-Master-Sword hit landed on Twinrova (#98)
+    int bossHealth = 0; // live boss colChkInfo.health, polled for #13 only
+    int fairyCount = 0;
+    int bombAmmo = 0;
+    int bombchuAmmo = 0;
+    int lastHealth = 0;
+    int frames = 0; // logic ticks since the baselines (20 Hz; #93 < 2220)
+};
+static FightTracker sFight;
+
+// Run #29 boss-hit attribution. The boss actors report every hit that
+// actually reduces their health (via Achievements_NotifyBossHit, called
+// from the boss's own collision code), with the toucher's dmgFlags. The
+// tracker latches "a hit by a disallowed weapon landed" per boss, and the
+// verdict reads it at the defeat (or, for #13, when the health reaches
+// the target). The allowed masks are the DMG_ constants
+// (soh/include/z64collision_check.h): DMG_HAMMER = swing|jump, DMG_ARROW
+// = all arrow types, Master Sword = slash|spin|jump of the Master Sword.
+// A hit that deals no damage (hookshot on Volvagia/Twinrova, a hit at
+// full health clamp) never calls the notify, so it cannot disqualify.
+extern "C" void Achievements_NotifyBossHit(u32 dmgFlags) {
+    if (!sFight.armed) {
+        return;
+    }
+    switch (sFight.bossActorId) {
+        case ACTOR_BOSS_FD2: // Volvagia (#95): only the Megaton Hammer.
+            if ((dmgFlags & DMG_HAMMER) == 0) {
+                sFight.nonHammerHit = true;
+            }
+            break;
+        case ACTOR_BOSS_GANONDROF: // Phantom Ganon (#13): only the Bow.
+            if ((dmgFlags & DMG_ARROW) == 0) {
+                sFight.nonArrowHit = true;
+            }
+            break;
+        case ACTOR_BOSS_TW: // Twinrova (#98): only the Master Sword.
+            // (The Mirror Shield's reflected beam only stuns her — it
+            // deals no health damage, so it needs no notify; the stun
+            // itself is inherently Mirror-Shield-only.)
+            if ((dmgFlags & (DMG_SLASH_MASTER | DMG_SPIN_MASTER | DMG_JUMP_MASTER)) == 0) {
+                sFight.nonMasterSwordHit = true;
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+// Run #29, #1 Spider Net: Gohma started her retreat to the ceiling.
+// Called from BossGoma_SetupWallClimb (z_boss_goma.c), the single place
+// the climb begins (when she touches a wall on the floor).
+extern "C" void Achievements_NotifyGohmaRetreat() {
+    if (sFight.armed && sFight.bossActorId == ACTOR_BOSS_GOMA) {
+        sFight.gohmaRetreated = true;
+    }
+}
