+
+// "Reiniciar logros" (run #26, Lux): destructive, so two steps. First
+// press arms the confirmation (in-memory only, like gRevealConfirm);
+// second press actually resets. Cancel disarms. Lives in the Logros
+// sidebar, after the reward switches and before the achievement lists:
+// it resets ALL achievements (both categories), so it sits above the
+// lists, not inside either of them.
+static bool gResetConfirmArmed = false;
+
+static void DrawResetAchievements(WidgetInfo&) {
+    ImGui::SeparatorText(Achievements::Tr("Reset achievements", "Reiniciar logros").c_str());
+    ImGui::TextColored(kPalMuted, "%s",
+                       Achievements::Tr("Clears all unlocks, reveals and the bribe counter.",
+                                        "Borra todos los desbloqueos, revelados y el contador de sobornos.")
+                           .c_str());
+    if (!gResetConfirmArmed) {
+        if (ImGui::Button(Achievements::Tr("Reset achievements", "Reiniciar logros").c_str())) {
+            gResetConfirmArmed = true;
+        }
+    } else {
+        ImGui::TextColored(kPalMuted, "%s",
+                           Achievements::Tr("Are you sure? This cannot be undone.",
+                                            "¿Seguro? Esto no se puede deshacer.")
+                               .c_str());
+        if (ImGui::Button(Achievements::Tr("Yes, reset everything", "Sí, borrar todo").c_str())) {
+            Achievements::ResetAll();
+            gResetConfirmArmed = false;
+        }
+        ImGui::SameLine();
+        if (ImGui::Button(Achievements::Tr("Cancel", "Cancelar").c_str())) {
+            gResetConfirmArmed = false;
+        }
+    }
+}
+
+void SohMenu::AddMenuAchievements() {
+    AddMenuEntry("Logros", CVAR_SETTING("Menu.LogrosSidebarSection"));
+    WidgetPath path;
+
+    // ---- Vanilla sidebar ----
+    path = { "Logros", "Logros", SECTION_COLUMN_1 };
+    AddSidebarEntry("Logros", path.sidebarName, 1);
+
+    // Run #30: rewards header (language buttons, Triforce, progress,
+    // rank, slot pips, milestones, secret letter) + reward cards.
+    // The old language combobox is gone: EN | ES buttons in the header
+    // set gAchievements.Language directly (UpdateAchievementsLanguage
+    // rewrites the stored labels every frame, so the switch is live).
+    AddWidget(path, "Rewards header", WIDGET_CUSTOM).CustomFunction(DrawRewardsHeader);
+    AddWidget(path, Achievements::Tr("Rewards", "Recompensas"), WIDGET_SEPARATOR_TEXT);
+    AddWidget(path, "Rewards grid", WIDGET_CUSTOM).CustomFunction(DrawRewardsGrid);
+    AddWidget(path, Achievements::Tr("L3+R3 action", "Acción de L3+R3"), WIDGET_CVAR_COMBOBOX)
+        .CVar("gAchievements.L3R3Mode")
+        .Options(ComboboxOptions().ComboMap(l3r3Modes).DefaultIndex(1));
+
+    // "Reiniciar logros" (run #26, Lux): destructive reset of ALL
+    // achievements, with confirmation. Custom widget: the button text is
+    // drawn live via Tr(), and the stored widget name ("Reset
+    // achievements" / "Reiniciar logros") is in kAchievementsLabels so
+    // the live-language rewrite picks it up.
+    AddWidget(path, Achievements::Tr("Reset achievements", "Reiniciar logros"), WIDGET_CUSTOM)
+        .CustomFunction(DrawResetAchievements);
+
+    AddWidget(path, Achievements::Tr("Achievements", "Logros"), WIDGET_SEPARATOR_TEXT);
+    AddWidget(path, Achievements::Tr("Vanilla achievements", "Logros vainilla"), WIDGET_CUSTOM)
+        .CustomFunction(DrawVanillaList);
+
+    // ---- Randomizer sidebar ----
+    path = { "Logros", "Randomizer", SECTION_COLUMN_1 };
+    AddSidebarEntry("Logros", path.sidebarName, 1);
+    AddWidget(path, Achievements::Tr("Randomizer achievements", "Logros del Randomizer"), WIDGET_CUSTOM)
+        .CustomFunction(DrawRandomizerList);
+}
+
+// ---------------------------------------------------------------------------
+// Live language for the Logros menu labels.
+//
+// The widget labels (combobox, separators) are plain strings stored in
+// WidgetInfo at menu construction (AddMenuAchievements above), so they
+// used to keep the language active at boot until the next restart, while
+// the achievement lists (WIDGET_CUSTOM, drawn live via Tr()) followed the
+// selector immediately. MenuDrawItem reads widget.name fresh on every
+// draw, so rewriting the stored names when the language CVar changes is
+// enough: the next frame draws the new language. No rebuild of the menu,
+// no custom widgets, no ImGui state churn — and nothing else is touched.
+// The EN | ES buttons in the header set the CVar directly; the rewrite
+// runs every frame from SohMenu::UpdateElement.
+//
+// The table below must list every stored label AddMenuAchievements()
+// creates, in the same EN/ES wording. Matching is by current name (EN or
+// ES form), so it works no matter which language the game booted with,
+// and widgets this table does not know are left alone. (The reward cards
+// and the header draw their labels live via Tr(), so they need no entry.)
+static const std::pair<const char*, const char*> kAchievementsLabels[] = {
+    { "L3+R3 action", "Acción de L3+R3" },
+    { "Rewards", "Recompensas" },
+    { "Reset achievements", "Reiniciar logros" },
+    { "Achievements", "Logros" },
+    { "Vanilla achievements", "Logros vainilla" },
+    { "Randomizer achievements", "Logros del Randomizer" },
+};
+
+// Last achievements language applied to the stored widget names (-1 = none yet).
+static int sAppliedAchievementsLanguage = -1;
+
+void SohMenu::UpdateAchievementsLanguage() {
+    if (!mMenuElementsInitialized) {
+        return;
+    }
+    const int language = Achievements::Language();
+    if (language == sAppliedAchievementsLanguage) {
+        return;
+    }
+    auto it = menuEntries.find("Logros");
+    if (it == menuEntries.end()) {
+        return;
+    }
+    for (auto& [sidebarName, sidebar] : it->second.sidebars) {
+        for (auto& column : sidebar.columnWidgets) {
+            for (WidgetInfo& widget : column) {
+                for (const auto& [en, es] : kAchievementsLabels) {
+                    if (widget.name == en || widget.name == es) {
+                        widget.name = Achievements::Tr(en, es);
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    sAppliedAchievementsLanguage = language;
+}
+
+} // namespace SohGui
