+static void EmitTestToast() {
+    // Same shape as a real unlock toast (same "Ver en Logros" action, same
+    // ToastVisible bookkeeping so the touchpad shortcut sees it), but the
+    // text says TEST and nothing persistent is touched: no unlock CVar, no
+    // SaveNow, no unseen badge, no counter change.
+    SetToastVisible(true);
+    auto onToastDismissed = []() { SetToastVisible(false); };
+    Notification::Emit({
+        .prefix = Tr("Test notification", "Aviso de prueba"),
+        .message = Tr("Test toast — no achievement unlocked",
+                      "Aviso de prueba — ningún logro desbloqueado"),
+        .suffix = Tr("TEST", "PRUEBA"),
+        .actionLabel = Tr("View in Achievements", "Ver en Logros"),
+        .action = []() { OpenLogrosMenu(); },
+        .onDismiss = onToastDismissed,
+    });
