+static bool CheckAllMasks() {
+    static const u8 kMasks[] = {
+        ITEM_MASK_KEATON, ITEM_MASK_SKULL, ITEM_MASK_SPOOKY, ITEM_MASK_BUNNY,
+        ITEM_MASK_GORON, ITEM_MASK_ZORA, ITEM_MASK_GERUDO, ITEM_MASK_TRUTH,
+    };
+    for (u8 mask : kMasks) {
+        if (INV_CONTENT(mask) != mask) {
+            return false;
+        }
+    }
+    return true;
+}
