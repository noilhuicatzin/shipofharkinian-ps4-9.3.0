+static void DrawRewardsGrid(WidgetInfo&) {
+    ImGui::TextColored(kPalMuted, "%s",
+                       Achievements::Tr("Each reward can be turned off", "Cada recompensa se puede apagar").c_str());
+    const float availW = ImGui::GetContentRegionAvail().x;
+    const float spacingX = ImGui::GetStyle().ItemSpacing.x;
+    const float spacingY = ImGui::GetStyle().ItemSpacing.y;
+    const int cols = (availW >= 520.0f) ? 4 : 2;
+    const float cardW = (availW - (cols - 1) * spacingX) / cols;
