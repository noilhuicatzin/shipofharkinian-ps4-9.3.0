 void Menu::AddSearchWidget(SearchWidget widget) {
     extraSearchWidgets.push_back(widget);
 }
 
+// R1/L1 header switching (run #25, Lux): cycle only the TOP headers
+// (Logros, Network, Enhancements, Settings, ...) in menu order, wrapping
+// around. Sets only the ActiveHeader CVar and saves — the section is
+// resolved by DrawElement from that header's sidebar CVar: its last
+// visited section, or its first section when the stored value is invalid
+// (DrawElement falls back to sidebarOrder.at(0)). That is exactly what
+// tapping the header tab does. Called from Achievements::CheckMenuInput
+// with the menu open (game input is blocked then, so R1/L1 cannot leak
+// into gameplay). No-op when there is one header or none, or when the
+// current header cannot be found.
+void Menu::CycleHeader(int dir) {
+    if (dir == 0 || menuOrder.empty()) {
+        return;
+    }
+    const char* headerCvar = CVAR_SETTING("Menu.ActiveHeader");
+    const std::string headerIndex = CVarGetString(headerCvar, "Settings");
+    int current = -1;
+    for (int i = 0; i < static_cast<int>(menuOrder.size()); ++i) {
+        if (menuOrder[i] == headerIndex) {
+            current = i;
+            break;
+        }
+    }
+    if (current < 0) {
+        return;
+    }
+    const int total = static_cast<int>(menuOrder.size());
+    if (total <= 1) {
+        return;
+    }
+    int next = (current + dir) % total;
+    if (next < 0) {
+        next += total;
+    }
+    CVarSetString(headerCvar, menuOrder[next].c_str());
+    CVarSave();
+    // TEMP DIAG: proves the header switch on console.
+    SPDLOG_INFO("[PS4] [diag] menu header -> {}", menuOrder[next]);
+    spdlog::default_logger()->flush();
+}
